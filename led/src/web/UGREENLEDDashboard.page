// Dashboard tile: Unraid's dashboard (6.12+) shows every $mytiles entry as a
// movable tile; each tile is a <tbody>, its title is the name in the content manager.
// The header follows Unraid's own tiles (DashStats.page), which also makes the
// dashboard add its collapse button to .tile-header-right-controls.
require_once '/usr/local/emhttp/plugins/ugreen-nas-control/led/include/lang.php';
[$ulc_lang] = ulc_language();
$ulc_theme = ulc_theme();
$ulc_dash_size = ulc_dash_size();

$ulc_theme_attr = $ulc_theme === 'light' ? 'light' : 'dark';

$mytiles['ugreen-led-control']['column2'] = <<<EOT
<tbody id="ulc-dash-tile" title="UGREEN LED Control">
<tr><td>
<span class="tile-header">
<span class="tile-header-left">
<img src="/plugins/ugreen-nas-control/led/images/ugreen-led-control.png" class="ulc-dash-icon" alt="">
<div class="section"><h3 class="tile-header-main">UGREEN LED Control</h3><span id="ulc-dash-state"></span></div>
</span>
<span class="tile-header-right">
<span class="tile-header-right-controls">
<a href="/Settings/UGREENNASControl" id="ulc-dash-settings"><i class="fa fa-fw fa-cog control"></i></a>
</span>
</span>
</span>
</td></tr>
<tr><td>
<div class="ulc ulc-dash" id="ulc-dash" data-theme="{$ulc_theme_attr}" data-size="{$ulc_dash_size}"><div class="ulc-nas" data-nas></div></div>
</td></tr>
</tbody>
EOT;
?>
<link rel="stylesheet" href="<?autov('/plugins/ugreen-nas-control/led/css/app.css')?>">
<script>
window.UGREEN_LED_LANG = <?= json_encode($ulc_lang) ?>;
window.UGREEN_LED_THEME = <?= json_encode($ulc_theme) ?>;
window.UGREEN_LED_DASH_SIZE = <?= json_encode($ulc_dash_size) ?>;
</script>
<script src="<?autov('/plugins/ugreen-nas-control/led/js/i18n.js')?>"></script>

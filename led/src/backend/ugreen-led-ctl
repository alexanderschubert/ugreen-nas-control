#!/bin/bash
#
# UGREEN LED Control
# Backend: talks to the LED controller through ugreen-led-i2c (no kernel module).
#

set -u

HERE="$(dirname "$(readlink -f "$0")")"
LED_TOOL="${UGREEN_LED_I2C:-$HERE/ugreen-led-i2c}"
CONFIG="${UGREEN_LED_CONFIG:-/boot/config/plugins/ugreen-nas-control/leds.cfg}"
DISKS_INI="${UGREEN_DISKS_INI:-/var/local/emhttp/disks.ini}"
VAR_INI="${UGREEN_VAR_INI:-/var/local/emhttp/var.ini}"
SMART_DIR="${UGREEN_SMART_DIR:-/var/local/emhttp/smart}"
SYS_BLOCK="${UGREEN_SYS_BLOCK:-/sys/block}"
SYS_NET="${UGREEN_SYS_NET:-/sys/class/net}"
SYS_ATA="${UGREEN_SYS_ATA:-/sys/class/ata_port}"
SYS_PCI="${UGREEN_SYS_PCI:-/sys/bus/pci/devices}"
PIDFILE="${UGREEN_PIDFILE:-/var/run/ugreen-nas-control.led.pid}"
SCHEDULE_STATE="${UGREEN_SCHEDULE_STATE:-/var/run/ugreen-nas-control.led.schedule}"
FX_PIDFILE="${UGREEN_FX_PIDFILE:-/var/run/ugreen-nas-control.led-fx.pid}"
FX_LOG="${UGREEN_FX_LOG:-/var/run/ugreen-nas-control.led-fx.log}"
IDENTIFY_PREFIX="${UGREEN_IDENTIFY_PREFIX:-/var/run/ugreen-nas-control.led.identify-}"
ALERT_STATE="${UGREEN_ALERT_STATE:-/var/run/ugreen-nas-control.led.alert}"
# tmpfs: when each LED last got a blink/breath command ("epoch_ms on off"), for the web preview's phase.
PHASE_PREFIX="${UGREEN_PHASE_PREFIX:-/var/run/ugreen-nas-control.led.phase-}"
SHUTDOWN_MARK="${UGREEN_SHUTDOWN_MARK:-/var/run/ugreen-nas-control.led.shutdown}"
BUS_CACHE="${UGREEN_BUS_CACHE:-/var/run/ugreen-nas-control.led.bus}"
DYNAMIX_CFG="${UGREEN_DYNAMIX_CFG:-/boot/config/plugins/dynamix/dynamix.cfg}"

DEFAULT_DISK_COLOR="255 160 0"
DEFAULT_NETDEV_COLOR="0 200 83"
DEFAULT_ERROR_COLOR="255 59 48"
DEFAULT_SYNC_COLOR="0 120 255"
DEFAULT_SMART_COLOR="255 140 0"
DEFAULT_SHUTDOWN_COLOR="255 140 0"

# Network LED by link speed (Mbit/s -> colour); a speed uses the largest step at or below it.
SPEED_STEPS="10 100 1000 2500 5000 10000"
default_speed_color() {
    case "$1" in
        10) echo "255 59 48" ;;
        100) echo "255 140 0" ;;
        1000) echo "255 214 10" ;;
        2500) echo "0 200 83" ;;
        5000) echo "0 200 200" ;;
        *) echo "0 120 255" ;;
    esac
}

# Hardware blink while a disk or the network is busy.
ACTIVITY_ON_MS=100
ACTIVITY_OFF_MS=100

# The model never changes while we run: read it once, no forks afterwards.
PRODUCT="${UGREEN_PRODUCT:-}"
[ -n "$PRODUCT" ] || read -r PRODUCT 2>/dev/null < /sys/class/dmi/id/product_name || true
[ -n "$PRODUCT" ] || PRODUCT="UGREEN NAS"

product_name() {
    echo "$PRODUCT"
}

# DXP6800 Pro -> 6, DX4600 Pro -> 4, DXP8800 Plus -> 8
BAYS=8
case "$PRODUCT" in
    iDX601[12]*) BAYS=6 ;;
    *)
        [[ $PRODUCT =~ ^DXP?([2-8])[0-9]{3} ]] && BAYS="${BASH_REMATCH[1]}"
        ;;
esac

bay_count() {
    echo "$BAYS"
}

# DXP480T Plus: no controller at 0x3a, only a power LED on a simpler chip (0x26),
# which the tool sets to static white. Fails on every other model.
dxp480t_apply() {
    case "$PRODUCT" in
        DXP480T*) tool dxp480t white ;;
        *) return 1 ;;
    esac
}

# The controller always knows disk1..disk8; only the bays the model has are real.
SUPPORTED_LEDS="power netdev"
for ((i = 1; i <= BAYS; i++)); do
    SUPPORTED_LEDS+=" disk$i"
done

supported_leds() {
    printf '%s' "$SUPPORTED_LEDS"
}

usage() {
    cat <<USAGE
UGREEN LED Control

Usage:
  ugreen-led-ctl status
  ugreen-led-ctl list
  ugreen-led-ctl get <led>
  ugreen-led-ctl all
  ugreen-led-ctl apply        (restore the settings saved by the web UI)
  ugreen-led-ctl bays         (which disk sits in which bay)
  ugreen-led-ctl daemon start|stop|restart|status|run
  ugreen-led-ctl schedule [--force]   (night mode and Unraid alerts; run every minute by cron)
  ugreen-led-ctl alerts [--force]     (Unraid alerts on the power LED only)
  ugreen-led-ctl fx start|stop|restart|status   (rainbow/temperature from leds.cfg)
  ugreen-led-ctl shutdown [--test]               (power LED signals shutdown/reboot; --test shows it for 6 s)
  ugreen-led-ctl smbus                           (load the SMBus driver, show the adapter or why it is missing)
  ugreen-led-ctl dxp480t                         (DXP480T Plus only: power LED to static white)
  ugreen-led-ctl identify <diskN> [seconds]      (blink a bay white, default 30 s)
  ugreen-led-ctl identify-stop <diskN>
  ugreen-led-ctl on <led>
  ugreen-led-ctl off <led>
  ugreen-led-ctl brightness <led> <0-255>
  ugreen-led-ctl color <led> <R> <G> <B>
  ugreen-led-ctl blink <led> <on_ms> <off_ms>
  ugreen-led-ctl breath <led> <on_ms> <off_ms>
  ugreen-led-ctl stop <led>
  ugreen-led-ctl help

Supported LEDs:
  power
  netdev
  disk1 ... diskN (N = number of bays)
USAGE
}

valid_led() {
    case " $SUPPORTED_LEDS " in
        *" $1 "*) return 0 ;;
    esac
    return 1
}

require_led() {
    valid_led "$1" || {
        echo "ERROR: LED '$1' not found." >&2
        return 1
    }
}

is_byte() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -le 255 ]
}

tool() {
    "$LED_TOOL" "$@" || return $?

    # Slow blink/breath commands only (they change rarely; the 0.2 s activity blink is not worth a file):
    # note the time so the browser can start its animation in step. No fork: bash builtins only.
    if [ "$1" = set ] && [ "$3" = blink -o "$3" = breath ] && [ $(( ${4:-0} + ${5:-0} )) -ge 500 ]; then
        local us="${EPOCHREALTIME//[.,]/}"
        printf '%s %s %s\n' "${us%???}" "$4" "$5" 2>/dev/null > "${PHASE_PREFIX}$2"
    fi
    return 0
}

# DXP4800 GT: the controller sits on an AMD DesignWare I2C controller (ACPI AMDI0010)
# that Unraid's kernel has no driver for; the helper drives it through /dev/mem.
is_gt() {
    case "$PRODUCT" in
        DXP4800*GT*) return 0 ;;
        *) return 1 ;;
    esac
}

has_smbus() {
    if is_gt; then
        grep -qs ' : AMDI0010:' /proc/iomem || grep -qs '^Synopsys DesignWare I2C adapter' /sys/bus/i2c/devices/i2c-*/name
    else
        grep -qs '^SMBus I801 adapter' /sys/bus/i2c/devices/i2c-*/name
    fi
}

# The LED controller sits on the Intel SMBus. Unraid usually loads its driver
# (i2c_i801) at boot, but not always (GitHub issue #30), so load it here and
# give udev a moment to register the adapter. i2c-dev makes it /dev/i2c-N.
ensure_smbus() {
    local i

    modprobe -q i2c-dev 2>/dev/null

    # The GT needs no driver (see is_gt).
    is_gt && { has_smbus; return; }

    # Already loaded without an adapter: nothing to wait for (dmesg tells why).
    grep -q '^i2c_i801 ' /proc/modules 2>/dev/null && { has_smbus; return; }
    modprobe -q i2c_i801 2>/dev/null || return 1

    for i in $(seq 1 30); do
        has_smbus && return 0
        sleep 0.1
    done
    return 1
}

# "<name> <mode> <brightness> <R> <G> <B> <on_ms> <off_ms>"
led_line() {
    tool --plain get "$1"
}

led_mode() {
    led_line "$1" | cut -d' ' -f2
}

# ============================================================
# Reading
# ============================================================

# What the web UI expects: brightness 0 while off, effect none|blink|breath.
status_json() {
    local name="$1"
    local mode="$2"
    local brightness="$3"
    local color="$4 $5 $6"
    local effect="none"

    case "$mode" in
        off) brightness=0 ;;
        blink|breath) effect="$mode" ;;
    esac

    printf '{\n'
    printf '  "name": "%s",\n' "$name"
    printf '  "brightness": "%s",\n' "$brightness"
    printf '  "max_brightness": "255",\n'
    printf '  "color": "%s",\n' "$color"
    printf '  "effect": "%s",\n' "$effect"
    printf '  "on_ms": "%s",\n' "$7"
    printf '  "off_ms": "%s"' "$8"

    # Phase: ms epoch of the last blink/breath command with these timings and now, same clock.
    local sent stamp_on stamp_off
    if [ "$mode" = blink -o "$mode" = breath ] && read -r sent stamp_on stamp_off 2>/dev/null < "${PHASE_PREFIX}$name" \
        && [ "$stamp_on" = "$7" ] && [ "$stamp_off" = "$8" ]; then
        local us="${EPOCHREALTIME//[.,]/}"
        printf ',\n  "sent_ms": %s,\n  "now_ms": %s' "$sent" "${us%???}"
    fi
    printf '\n}\n'
}

get_status() {
    local line

    require_led "$1" || return 1
    line="$(led_line "$1")" || return 1

    # shellcheck disable=SC2086 # the line is eight space-separated fields
    status_json $line
}

all_leds() {
    local first=1
    local name mode brightness r g b on off

    printf '{\n'
    while read -r name mode brightness r g b on off; do
        valid_led "$name" || continue
        [ "$first" -eq 1 ] || printf ',\n'
        printf '"%s": ' "$name"
        status_json "$name" "$mode" "$brightness" "$r" "$g" "$b" "$on" "$off"
        first=0
    done < <(tool --plain get all 2>/dev/null)
    printf '}\n'
}

list_leds() {
    local first=1
    local led

    printf '['
    # Only when the controller answers; an empty list tells the UI nothing is there.
    if tool --plain get power >/dev/null 2>&1; then
        for led in $(supported_leds); do
            [ "$first" -eq 1 ] || printf ', '
            printf '"%s"' "$led"
            first=0
        done
    fi
    printf ']\n'
}

# ich777's ugreenleds-driver monitor writes the same LEDs.
foreign_monitor_running() {
    pgrep -f '^/bin/bash /usr/bin/ugreen-leds' >/dev/null 2>&1
}

status() {
    local probe
    local bus=""
    local found="failed"
    local attempt
    local kernel=""
    local net_dev
    local v
    local mode=manual
    local fx=""
    local sync_action sync_percent=0
    local alert_active=false
    local identify
    local netdev_mode

    # One failed probe (the controller did not answer while the daemon or an effect was
    # writing) is not "no controller": ask up to three times, then fall back to the bus
    # that answered within the last 10 minutes.
    for attempt in 1 2 3; do
        if probe="$(tool probe 2>/dev/null)"; then
            if [[ $probe =~ \"bus\":\ \"/dev/i2c-([0-9]*)\" ]]; then
                bus="${BASH_REMATCH[1]}"
            elif [[ $probe =~ \"bus\":\ \"(/dev/mem)\" ]]; then
                bus="\"${BASH_REMATCH[1]}\""
            fi
        fi
        [ -n "$bus" ] && break
        sleep 0.3
    done
    if [ -n "$bus" ]; then
        found="ok"
        printf '%s\n' "$bus" 2>/dev/null > "$BUS_CACHE" || true
    elif [ -n "$(find "$BUS_CACHE" -mmin -10 2>/dev/null)" ]; then
        read -r bus 2>/dev/null < "$BUS_CACHE"
        [ -n "$bus" ] && found="cached"
    fi

    read -r kernel 2>/dev/null < /proc/sys/kernel/osrelease
    [ "${CFG[mode]:-}" = status ] && mode=status
    fx_running && fx="${CFG[fx_name]:-}"
    sync_state_v
    sync_action="${SYNC%% *}"
    [ -n "$SYNC" ] && sync_percent="${SYNC##* }"
    v=""
    read -r v 2>/dev/null < "$ALERT_STATE"
    [ "$v" = alert ] && alert_active=true
    identify="$(identifying_leds)"
    net_dev="$(network_device)"
    netdev_status_v
    netdev_mode="$REPLY"

    printf '{\n'
    printf '  "ok": true,\n'
    if foreign_monitor_running; then
        printf '  "foreign_monitor": true,\n'
    else
        printf '  "foreign_monitor": false,\n'
    fi
    printf '  "model": "%s",\n' "$PRODUCT"
    printf '  "bays": %s,\n' "$BAYS"
    printf '  "kernel": "%s",\n' "$kernel"
    printf '  "mapping": "%s",\n' "$(mapping_source)"
    printf '  "mode": "%s",\n' "$mode"
    if daemon_running; then
        printf '  "daemon": true,\n'
    else
        printf '  "daemon": false,\n'
    fi
    printf '  "fx": "%s",\n' "$fx"
    printf '  "fx_leds": "%s",\n' "${CFG[fx_leds]:-}"
    printf '  "identify": %s,\n' "$identify"
    printf '  "sync_action": "%s",\n' "$sync_action"
    printf '  "sync_percent": %s,\n' "$sync_percent"
    printf '  "sync_enabled": %s,\n' "$(json_bool_not_0 sync_enabled)"
    printf '  "sync_color": "%s",\n' "${CFG[sync_color]:-$DEFAULT_SYNC_COLOR}"
    printf '  "standby_mode": "%s",\n' "${CFG[standby_mode]:-dim}"
    printf '  "standby_level": %s,\n' "${CFG[standby_level]:-30}"
    printf '  "smart_enabled": %s,\n' "$(json_bool_not_0 smart_enabled)"
    printf '  "error_enabled": %s,\n' "$(json_bool_not_0 error_enabled)"
    printf '  "activity_enabled": %s,\n' "$(json_bool_not_0 activity_enabled)"
    printf '  "smart_color": "%s",\n' "${CFG[smart_color]:-$DEFAULT_SMART_COLOR}"
    printf '  "disk_color_mode": "%s",\n' "${CFG[disk_color_mode]:-own}"
    printf '  "netdev_status": "%s",\n' "$netdev_mode"
    printf '  "alert_enabled": %s,\n' "$(json_bool_1 alert_enabled)"
    printf '  "alert_level": "%s",\n' "${CFG[alert_level]:-warning}"
    printf '  "alert_color": "%s",\n' "${CFG[alert_color]:-$DEFAULT_ERROR_COLOR}"
    printf '  "shutdown_blink": %s,\n' "$(json_bool_1 shutdown_blink)"
    printf '  "shutdown_color": "%s",\n' "${CFG[shutdown_color]:-$DEFAULT_SHUTDOWN_COLOR}"
    v="${CFG[shutdown_effect]:-}"
    [ "$v" = breath ] || v=blink
    printf '  "shutdown_effect": "%s",\n' "$v"
    printf '  "alert_count": %s,\n' "$(unread_alerts)"
    printf '  "alert_active": %s,\n' "$alert_active"
    printf '  "fx_speed": %s,\n' "${CFG[fx_speed]:-2}"
    printf '  "fx_reverse": %s,\n' "$(json_bool_1 fx_reverse)"
    printf '  "fx_idle": %s,\n' "$(json_bool_1 fx_idle)"
    if is_night; then
        printf '  "night": true,\n'
    else
        printf '  "night": false,\n'
    fi
    printf '  "disk_error_color": "%s",\n' "${CFG[disk_error_color]:-$DEFAULT_ERROR_COLOR}"
    printf '  "saved_brightness": %s,\n' "$(saved_brightness_json)"
    printf '  "network_device": "%s",\n' "$net_dev"
    printf '  "netdev_speed": %s,\n' "$(link_speed "$net_dev")"
    printf '  "network_ports": %s,\n' "$(network_ports_json)"
    printf '  "netdev_speed_enabled": %s,\n' "$(json_bool_1 netdev_speed_enabled)"
    printf '  "netdev_speed_colors": %s,\n' "$(speed_colors_json)"
    printf '  "controller": "ugreen-led-i2c",\n'
    if [ -n "$bus" ]; then
        printf '  "i2c_bus": %s,\n' "$bus"
        printf '  "i2c_address": "0x3a",\n'
        printf '  "i2c_probe": "%s",\n' "$found"
    else
        printf '  "i2c_bus": null,\n'
        printf '  "i2c_address": null,\n'
        printf '  "i2c_probe": "failed",\n'
    fi
    printf '  "leds": '
    list_leds
    printf '}\n'
}

# JSON true/false from a setting: true unless it is 0 / true only when it is 1.
json_bool_not_0() {
    [ "${CFG[$1]:-}" = 0 ] && echo false || echo true
}

json_bool_1() {
    [ "${CFG[$1]:-}" = 1 ] && echo true || echo false
}

# ============================================================
# Writing
# ============================================================

set_color() {
    local led="$1"
    local value

    require_led "$led" || return 1
    for value in "$2" "$3" "$4"; do
        is_byte "$value" || {
            echo "ERROR: RGB values must be between 0 and 255." >&2
            return 1
        }
    done

    tool set "$led" color "$2" "$3" "$4"
}

# Brightness 0 switches the LED off; any other value also switches an off LED on.
set_brightness() {
    local led="$1"
    local value="$2"

    require_led "$led" || return 1
    is_byte "$value" || {
        echo "ERROR: Brightness must be between 0 and 255." >&2
        return 1
    }

    if [ "$value" -eq 0 ]; then
        tool set "$led" off
        return
    fi

    tool set "$led" brightness "$value" || return 1
    [ "$(led_mode "$led")" = "off" ] && tool set "$led" on
    return 0
}

set_on() {
    require_led "$1" || return 1
    tool set "$1" brightness 255 && tool set "$1" on
}

set_off() {
    require_led "$1" || return 1
    tool set "$1" off
}

set_effect() {
    local effect="$1"
    local led="$2"

    require_led "$led" || return 1
    tool set "$led" "$effect" "$3" "$4"
}

# Back to a steady light; an LED that is off stays off.
stop_effect() {
    local mode

    require_led "$1" || return 1
    mode="$(led_mode "$1")" || return 1

    case "$mode" in
        blink|breath) tool set "$1" on ;;
    esac
}

# ============================================================
# Saved settings
# ============================================================

# The settings file is parsed once into CFG (key="value" lines, the last one of a key wins, nothing
# is sourced) and again only when its content changed: no sed/tail per setting.
declare -A CFG=()
CFG_RAW=""
CFG_LOADED=""

cfg_load() {
    local raw=""
    local line

    [ -r "$CONFIG" ] && raw="$(<"$CONFIG")"
    [ -n "$CFG_LOADED" ] && [ "$raw" = "$CFG_RAW" ] && return 0

    CFG=()
    while IFS= read -r line; do
        [[ $line =~ ^([A-Za-z0-9_]+)=\"(.*)\"$ ]] && CFG[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"
    done <<< "$raw"
    CFG_RAW="$raw"
    CFG_LOADED=1
}

# One value from the settings file, empty when unset: for callers outside the hot paths
# (inside the daemon, read CFG[key] directly).
config_value() {
    printf '%s\n' "${CFG[$1]:-}"
}

# Network LED in status mode: activity (blinks with traffic), link (steady,
# error colour without a connection) or manual (the daemon leaves it alone).
netdev_status_v() {
    REPLY="${CFG[netdev_status]:-}"
    case "$REPLY" in
        activity|link|manual) ;;
        *) REPLY=activity ;;
    esac
}

netdev_status() {
    netdev_status_v
    echo "$REPLY"
}

# Saved colour, brightness and effect of one LED.
apply_led() {
    local led="$1"
    local color
    local brightness
    local effect

    color="${CFG[${led}_color]:-}"
    brightness="${CFG[${led}_brightness]:-}"
    effect="${CFG[${led}_effect]:-}"

    # shellcheck disable=SC2086 # "R G B" is meant to split into three arguments
    [ -n "$color" ] && set_color "$led" $color
    [ -n "$brightness" ] && set_brightness "$led" "$brightness"

    # An effect would light an LED that is meant to be off.
    [ "${brightness:-1}" = "0" ] && return 0

    case "$effect" in
        blink) set_effect blink "$led" "${CFG[${led}_on]:-450}" "${CFG[${led}_off]:-450}" ;;
        breath) set_effect breath "$led" "${CFG[${led}_on]:-1200}" "${CFG[${led}_off]:-900}" ;;
        none) stop_effect "$led" ;;
    esac
}

apply_config() {
    local led

    if [ ! -f "$CONFIG" ]; then
        echo "No saved settings ($CONFIG)."
        return 0
    fi

    for led in $(supported_leds); do
        apply_led "$led"
    done

    echo "Saved settings applied."
}

saved_color() {
    echo "${CFG[${1}_color]:-$2}"
}

# {"power": 204, ...}: the day brightness of every LED that has one saved;
# at night the LEDs themselves show the dimmed value.
saved_brightness_json() {
    local led
    local value
    local out=""

    for led in $(supported_leds); do
        value="${CFG[${led}_brightness]:-}"
        is_byte "$value" 2>/dev/null && out="$out, \"$led\": $value"
    done
    printf '{%s}' "${out#, }"
}

saved_brightness() {
    echo "${CFG[${1}_brightness]:-255}"
}

# ============================================================
# Night mode
# ============================================================

# night_enabled="1", night_start/night_end "HH:MM" (may span midnight),
# night_action "dim" (down to night_brightness, 0-255) or "off".
is_night() {
    local start
    local end
    local now

    [ "${CFG[night_enabled]:-}" = "1" ] || return 1

    start="${CFG[night_start]:-22:00}"
    end="${CFG[night_end]:-07:00}"
    now="${UGREEN_NOW:-}"
    [ -n "$now" ] || printf -v now '%(%H%M)T' -1
    start="${start/:/}"
    end="${end/:/}"

    if [ "$((10#$start))" -lt "$((10#$end))" ]; then
        [ "$((10#$now))" -ge "$((10#$start))" ] && [ "$((10#$now))" -lt "$((10#$end))" ]
    elif [ "$((10#$start))" -gt "$((10#$end))" ]; then
        [ "$((10#$now))" -ge "$((10#$start))" ] || [ "$((10#$now))" -lt "$((10#$end))" ]
    else
        return 1
    fi
}

# Brightness to show: the saved one by day, at most the night level (or 0) by night.
effective_brightness_v() {
    local saved="$1"
    local night="$2"
    local level

    if [ "$night" -eq 1 ]; then
        [ "${CFG[night_action]:-}" = "off" ] && { REPLY=0; return; }
        level="${CFG[night_brightness]:-20}"
        [ "$saved" -gt "$level" ] && saved="$level"
    fi

    REPLY="$saved"
}

effective_brightness() {
    effective_brightness_v "$1" "$2"
    echo "$REPLY"
}

# Night look for LEDs the daemon doesn't drive: dim or off, effects keep running.
apply_night() {
    local led
    local brightness

    for led in "$@"; do
        brightness="$(effective_brightness "$(saved_brightness "$led")" 1)"
        if [ "$brightness" -eq 0 ]; then
            tool set "$led" off >/dev/null 2>&1
        else
            tool set "$led" brightness "$brightness" >/dev/null 2>&1
        fi
    done
}

# Switch between day and night when the state changes (cron runs this every minute).
schedule_tick() {
    local force="${1:-}"
    local wanted="day"
    local leds

    is_night && wanted="night"
    [ "$force" != "--force" ] && [ "$(cat "$SCHEDULE_STATE" 2>/dev/null)" = "$wanted" ] && return 1
    echo "$wanted" > "$SCHEDULE_STATE"

    if daemon_running; then
        # The daemon picks up day/night itself after a restart; the power LED is ours,
        # and so is the network LED when it stays manual.
        daemon_command restart >/dev/null
        leds="power"
        [ "$(netdev_status)" = "manual" ] && leds="power netdev"
    else
        apply_config >/dev/null
        leds="$(supported_leds)"
    fi

    # shellcheck disable=SC2086
    [ "$wanted" = "night" ] && apply_night $leds

    log "night mode: $wanted"
}

# ============================================================
# Unraid alerts on the power LED
# ============================================================

# alert_enabled="1", alert_level "warning" (warnings and alerts) or "alert",
# alert_color "R G B". Unraid keeps unread notifications as *.notify files.
notify_dir() {
    [ -n "$DYN_LOADED" ] || dyn_load
    echo "${UGREEN_NOTIFY_DIR:-${DYN_NOTIFY:-/tmp/notifications}}"
}

unread_alerts() {
    local level
    local file
    local importance
    local line
    local dir
    local count=0

    level="${CFG[alert_level]:-warning}"
    dir="$(notify_dir)"

    for file in "$dir"/unread/*.notify; do
        [ -e "$file" ] || continue
        importance=""
        while IFS= read -r line; do
            if [[ $line =~ ^importance=\"?([a-z]*)\"?$ ]]; then
                importance="${BASH_REMATCH[1]}"
                break
            fi
        done < "$file"
        case "$importance" in
            alert) count=$((count + 1)) ;;
            warning) [ "$level" = "warning" ] && count=$((count + 1)) ;;
        esac
    done

    echo "$count"
}

# Power LED back to normal: saved look, night mode, and its effect if any.
restore_power() {
    apply_led power >/dev/null 2>&1
    is_night && apply_night power

    case ",${CFG[fx_leds]:-}," in
        *,power,*) [ -n "${CFG[fx_name]:-}" ] && ! fx_running && fx_start >/dev/null 2>&1 ;;
    esac
    return 0
}

# The power LED while the NAS shuts down or reboots. emhttp calls event/stopping at the
# start of every array stop; only runlevel 0 (halt) or 6 (reboot) means the system goes
# down, a plain array stop leaves the LED alone. "--test" shows it for a few seconds.
shutdown_signal() {
    local test="${1:-}"
    local effect
    local color
    local brightness
    local night=0

    if [ "$test" != "--test" ]; then
        [ "${CFG[shutdown_blink]:-}" = "1" ] || return 0

        case "$(runlevel 2>/dev/null | awk '{print $2}')" in
            0|6) ;;
            *) return 0 ;;
        esac

        # From here on nothing else writes the power LED (night mode and alert ticks check this).
        : > "$SHUTDOWN_MARK"
        fx_stop
    fi

    effect="${CFG[shutdown_effect]:-}"
    [ "$effect" = "breath" ] || effect=blink
    color="${CFG[shutdown_color]:-$DEFAULT_SHUTDOWN_COLOR}"
    is_night && night=1
    brightness="$(effective_brightness "$(saved_brightness power)" "$night")"

    if [ "$brightness" -eq 0 ]; then
        tool set power off >/dev/null 2>&1
        return 0
    fi

    # shellcheck disable=SC2086
    tool set power color $color >/dev/null 2>&1
    tool set power brightness "$brightness" >/dev/null 2>&1
    if [ "$effect" = "breath" ]; then
        tool set power breath 1200 1200 >/dev/null 2>&1
    else
        tool set power blink 500 500 >/dev/null 2>&1
    fi

    if [ "$test" = "--test" ]; then
        # Back to the normal look after a few seconds.
        setsid bash -c 'sleep 6; exec "$1" power-restore' _ "$(readlink -f "$0")" </dev/null >/dev/null 2>&1 &
        echo "Power LED signals shutdown for 6 s."
    else
        log "Shutting down or rebooting: power LED signals it"
    fi
}

# While alerts are unread the power LED blinks in the alert colour; it is
# written every minute, so other writes (mode switch, night mode) can't hide it.
alert_tick() {
    local force="${1:-}"
    local count=0
    local last
    local brightness
    local night=0

    [ "${CFG[alert_enabled]:-}" = "1" ] && count="$(unread_alerts)"
    last="$(cat "$ALERT_STATE" 2>/dev/null)"

    if [ "$count" -gt 0 ]; then
        echo "alert" > "$ALERT_STATE"

        # A rainbow/temperature effect on the power LED would paint over it.
        case ",${CFG[fx_leds]:-}," in
            *,power,*) fx_running && fx_stop ;;
        esac

        is_night && night=1
        brightness="$(effective_brightness "$(saved_brightness power)" "$night")"
        if [ "$brightness" -eq 0 ]; then
            tool set power off >/dev/null 2>&1
        else
            # shellcheck disable=SC2046
            tool set power color ${CFG[alert_color]:-$DEFAULT_ERROR_COLOR} >/dev/null 2>&1
            tool set power brightness "$brightness" >/dev/null 2>&1
            tool set power blink 500 500 >/dev/null 2>&1
        fi

        [ "$last" = "alert" ] || log "Unraid alert: power LED signals $count unread notification(s)"
    elif [ "$last" = "alert" ] || [ "$force" = "--force" ]; then
        echo "none" > "$ALERT_STATE"
        [ "$last" = "alert" ] && restore_power && log "Unraid alerts read: power LED back to normal"
    fi
}

# ============================================================
# Status mode: bays, disk activity/health and network
# ============================================================

# SATA port of each bay, left to right, after miskcoo/ugreen_leds_controller.
# Only the DXP6800 differs from ata1..ataN in order.
# iDX6011 (Pro): bays 1-4 sit on the ASMedia SATA controller (PCI vendor 0x1b21), bays 5-6
# on the Intel PCH (0x8086), each in port order. Empty if either isn't found.
idx_bay_ports() {
    local vendor
    local port
    local pci
    local out=""
    local n=0

    for vendor in 0x1b21 0x8086; do
        for port in $(ls "$SYS_ATA" 2>/dev/null | sed -n 's/^ata\([0-9][0-9]*\)$/\1/p' | sort -n); do
            pci="$(readlink -f "$SYS_ATA/ata$port" 2>/dev/null | grep -oE '[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-9]' | tail -n 1)"
            [ -n "$pci" ] && [ "$(cat "$SYS_PCI/$pci/vendor" 2>/dev/null)" = "$vendor" ] || continue
            out="$out ata$port"
            n=$((n + 1))
        done
    done

    [ "$n" -eq 6 ] && echo "${out# }"
}

# The port table is fixed hardware: worked out once per process into BAY_PORTS.
BAY_PORTS=""
BAY_PORTS_SET=""

bay_ports_load() {
    local ports
    local i

    [ -n "$BAY_PORTS_SET" ] && return 0
    BAY_PORTS_SET=1

    case "$PRODUCT" in
        iDX601[12]*)
            ports="$(idx_bay_ports)"
            BAY_PORTS="${ports:-ata1 ata2 ata3 ata4 ata5 ata6}"
            return 0
            ;;
        DXP6800*) BAY_PORTS="ata3 ata4 ata5 ata6 ata1 ata2"; return 0 ;;
    esac

    for ((i = 1; i <= BAYS; i++)); do
        BAY_PORTS+="ata$i "
    done
}

# How sure the port table is: tested (here or by miskcoo), reported by users, or guessed.
mapping_source() {
    case "$PRODUCT" in
        DXP6800*|DX4600*|DXP8800*) echo tested ;;
        DXP4800*GT*) echo tested ;;
        DX4700*|DXP2800*|DXP4800*) echo reported ;;
        *) echo guessed ;;
    esac
}

# Serial of a disk (sets REPLY), from the udev database file (what udevadm reads), udevadm as fallback.
# Remembered until devpaths_refresh redoes the device table.
UDEV_DATA="${UGREEN_UDEV_DATA:-/run/udev/data}"
declare -A SERIALS=()

disk_serial_v() {
    local dev="$1"
    local mm
    local line
    local serial=""
    local found=0

    if [ -n "${SERIALS[$dev]+x}" ]; then
        REPLY="${SERIALS[$dev]}"
        return 0
    fi

    if read -r mm 2>/dev/null < "$SYS_BLOCK/$dev/dev" && [ -r "$UDEV_DATA/b$mm" ]; then
        found=1
        while IFS= read -r line; do
            if [[ $line == E:ID_SERIAL_SHORT=* ]]; then
                serial="${line#E:ID_SERIAL_SHORT=}"
                break
            fi
        done < "$UDEV_DATA/b$mm"
    fi
    [ "$found" -eq 1 ] || serial="$(udevadm info -q property -n "/dev/$dev" 2>/dev/null | sed -n 's/^ID_SERIAL_SHORT=//p')"

    SERIALS[$dev]="$serial"
    REPLY="$serial"
}

# Where each sdX sits (resolved /sys/block/sdX/device), one readlink for all of them. Redone when
# the set of disks changes and at the latest after a minute; the daemon asks every pass.
declare -A DEVPATH=()
declare -a DEVLIST=()
DEVPATH_SIG="-"
DEVPATH_AT=0

devpaths_refresh() {
    local dev
    local sig=""
    local i
    local -a out=()
    local -a links=()

    DEVLIST=()
    for dev in "$SYS_BLOCK"/sd*; do
        [ -e "$dev" ] || continue
        DEVLIST+=("${dev##*/}")
        sig+=" ${dev##*/}"
        links+=("$dev/device")
    done

    [ "$sig" = "$DEVPATH_SIG" ] && [ $((SECONDS - DEVPATH_AT)) -lt 60 ] && return 0

    DEVPATH=()
    SERIALS=()
    if [ "${#links[@]}" -gt 0 ]; then
        mapfile -t out < <(readlink -f "${links[@]}" 2>/dev/null)
        for i in "${!DEVLIST[@]}"; do
            DEVPATH[${DEVLIST[i]}]="${out[i]:-}"
        done
    fi
    DEVPATH_SIG="$sig"
    DEVPATH_AT=$SECONDS
}

# Block device (sdX) in a bay, in REPLY. A saved bay<N>_serial wins over the port table.
bay_device_v() {
    local bay="$1"
    local serial="${CFG[bay${bay}_serial]:-}"
    local port
    local dev
    local -a ports

    REPLY=""
    bay_ports_load
    read -ra ports <<< "$BAY_PORTS"
    port="${ports[bay - 1]:-}"

    for dev in "${DEVLIST[@]}"; do
        if [ -n "$serial" ]; then
            disk_serial_v "$dev"
            [ "$REPLY" = "$serial" ] && { REPLY="$dev"; return 0; }
        elif [ -n "$port" ]; then
            case "${DEVPATH[$dev]:-}" in
                */"$port"/*) REPLY="$dev"; return 0 ;;
            esac
        fi
    done
    REPLY=""
}

# Unraid's view of every device, from one pass over disks.ini, in DISKINFO[sdX]:
# "<slot> <status> <spundown 0|1> <temp|-> <errors> <rotational 0|1> <warning|-> <critical|-> <id>",
# e.g. "disk2 DISK_OK 1 - 0 1 - - ST4000VN006-3CW104_ZW628KBL". The first section of a device wins.
declare -A DISKINFO=()
d_name="" d_device="" d_status="" d_spundown="" d_temp="" d_errors="" d_rotational="" d_warning="" d_critical="" d_id=""

disks_flush() {
    [ -n "$d_device" ] && [ -n "$d_name" ] && [ -z "${DISKINFO[$d_device]+x}" ] || return 0
    [[ $d_temp =~ ^[0-9]+$ ]] || d_temp="-"
    [[ $d_warning =~ ^[0-9]+$ ]] || d_warning="-"
    [[ $d_critical =~ ^[0-9]+$ ]] || d_critical="-"
    DISKINFO[$d_device]="$d_name $d_status ${d_spundown:-0} $d_temp ${d_errors:-0} ${d_rotational:-1} $d_warning $d_critical ${d_id:--}"
}

disks_load() {
    local line key v

    DISKINFO=()
    d_name="" d_device="" d_status="" d_spundown="" d_temp="" d_errors="" d_rotational="" d_warning="" d_critical="" d_id=""
    [ -r "$DISKS_INI" ] || return 0

    while IFS= read -r line; do
        if [[ $line == \[* ]]; then
            disks_flush
            d_name="" d_device="" d_status="" d_spundown="" d_temp="" d_errors="" d_rotational="" d_warning="" d_critical="" d_id=""
            continue
        fi
        [[ $line == *=\"* ]] || continue
        key="${line%%=*}"
        v="${line#*=\"}"
        v="${v%%\"*}"
        case "$key" in
            rotational) d_rotational="$v" ;;
            warning) d_warning="$v" ;;
            critical) d_critical="$v" ;;
            id) d_id="$v" ;;
            name) d_name="$v" ;;
            device) d_device="$v" ;;
            status) d_status="$v" ;;
            spundown) d_spundown="$v" ;;
            temp) d_temp="$v" ;;
            numErrors) d_errors="$v" ;;
        esac
    done < "$DISKS_INI"
    disks_flush
}

# A running parity check/rebuild in SYNC: "<check|recon|clear> <percent>", empty when idle.
SYNC=""

sync_state_v() {
    local line
    local v
    local resync="" pos="" size="" action="" percent=0

    SYNC=""
    [ -r "$VAR_INI" ] || return 0

    while IFS= read -r line; do
        case "$line" in
            mdResync=\"*|mdResyncPos=\"*|mdResyncSize=\"*|mdResyncAction=\"*) ;;
            *) continue ;;
        esac
        v="${line#*\"}"
        v="${v%%\"*}"
        case "$line" in
            mdResync=*) resync="$v" ;;
            mdResyncPos=*) pos="$v" ;;
            mdResyncSize=*) size="$v" ;;
            mdResyncAction=*) read -r action _ <<< "$v" ;;
        esac
    done < "$VAR_INI"

    [ -n "$resync" ] && [ "$resync" != "0" ] || return 0
    [[ $pos =~ ^[0-9]+$ ]] || pos=0
    [[ $size =~ ^[0-9]+$ ]] || size=0
    [ "$size" -gt 0 ] && percent=$((pos * 100 / size))
    SYNC="$action $percent"
}

# dynamix.cfg: Unraid's global temperature limits and its notification folder.
declare -A DYN=()
DYN_NOTIFY=""
DYN_LOADED=""

dyn_load() {
    local line
    local section=""
    local v

    DYN=()
    DYN_NOTIFY=""
    DYN_LOADED=1
    [ -r "$DYNAMIX_CFG" ] || return 0

    while IFS= read -r line; do
        if [[ $line == \[* ]]; then
            section="$line"
        elif [[ $line =~ ^(hot|max|hotssd|maxssd)=\"([0-9]*)\"$ ]]; then
            [ -z "${DYN[${BASH_REMATCH[1]}]+x}" ] && DYN[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"
        elif [ "$section" = "[notify]" ] && [ -z "$DYN_NOTIFY" ] && [[ $line == path=\"* ]]; then
            v="${line#*\"}"
            DYN_NOTIFY="${v%%\"*}"
        fi
    done < "$DYNAMIX_CFG"
}

# Unraid's temperature limits for a disk: its own warning/critical, or the global
# hot/max (hotssd/maxssd for SSDs) from dynamix.cfg. Sets TL_HOT and TL_MAX.
TL_HOT=45
TL_MAX=55

temp_limits_v() {
    local rotational="$1"
    local warning="$2"
    local critical="$3"
    local hot_key="hot"
    local max_key="max"
    local hot
    local max

    [ -n "$DYN_LOADED" ] || dyn_load
    [ "$rotational" = "0" ] && { hot_key="hotssd"; max_key="maxssd"; }
    hot="${DYN[$hot_key]:-}"
    max="${DYN[$max_key]:-}"
    [ "$rotational" = "0" ] && { hot="${hot:-60}"; max="${max:-70}"; }

    [ "$warning" != "-" ] && hot="$warning"
    [ "$critical" != "-" ] && max="$critical"

    TL_HOT="${hot:-45}"
    TL_MAX="${max:-55}"
}

# Colour for a disk temperature: blue at hot-15, green at hot-7, yellow at hot, red at max.
temp_color() {
    local temp="$1"
    local hot="$2"
    local max="$3"
    local -a stops
    local i lo hi t span

    stops=("$((hot - 15)) 0 120 255" "$((hot - 7)) 0 200 83" "$hot 255 200 0" "$max 255 40 40")

    # shellcheck disable=SC2086
    set -- ${stops[0]}
    [ "$temp" -le "$1" ] && { echo "$2 $3 $4"; return; }

    for i in 1 2 3; do
        # shellcheck disable=SC2086
        set -- ${stops[i - 1]} ${stops[i]}
        lo="$1"
        hi="$5"
        if [ "$temp" -le "$hi" ]; then
            span=$((hi - lo))
            [ "$span" -lt 1 ] && span=1
            t=$((temp - lo))
            echo "$(( $2 + ($6 - $2) * t / span )) $(( $3 + ($7 - $3) * t / span )) $(( $4 + ($8 - $4) * t / span ))"
            return
        fi
    done

    echo "255 40 40"
}

# The watched SMART values from Unraid's cached smartctl output, plus Unraid's
# read/write error count, in SMART_NOW: "5=0 187=0 197=0 198=0 failed=0 errors=0".
# 188 (Command_Timeout) is left out: Seagate reports raw values like "0 0 0".
SMART_NOW=""

smart_now_v() {
    local slot="$1"
    local errors="$2"
    local a1 a9 a10 raw v
    local failed=0
    local -A val=([5]=0 [187]=0 [197]=0 [198]=0)

    if [ ! -r "$SMART_DIR/$slot" ]; then
        SMART_NOW="5=0 187=0 197=0 198=0 failed=0 errors=$errors"
        return 0
    fi

    while read -r a1 _ _ _ _ _ _ _ a9 a10 _; do
        case "$a1" in
            5|187|197|198)
                raw="${a10%%/*}"
                v=0
                [[ $raw =~ ^[0-9]+ ]] && v=$((10#${BASH_REMATCH[0]}))
                val[$a1]=$v
                [ "$a9" != "-" ] && failed=1
                ;;
        esac
        if [[ $a1 =~ ^[0-9]+$ ]] && [ "$a9" != "-" ] && [ -n "$a9" ]; then
            failed=1
        fi
    done < "$SMART_DIR/$slot"

    SMART_NOW="5=${val[5]} 187=${val[187]} 197=${val[197]} 198=${val[198]} failed=$failed errors=$errors"
}

# Config key for a disk's acknowledged SMART values, from its Unraid id.
smart_key() {
    echo "smart_ack_${1//[^A-Za-z0-9]/_}"
}

# Values that rose above what was acknowledged ("5=8 errors=2"), in SMART_WARN, empty if none.
SMART_WARN=""

smart_warnings_v() {
    local now="$1"
    local ack="$2"
    local pair
    local name
    local value
    local acked
    local word
    local out=""

    for pair in $now; do
        name="${pair%%=*}"
        value="${pair#*=}"
        acked=""
        for word in $ack; do
            [[ $word == "$name="* ]] && acked="${word#*=}"
        done
        [ "$value" -gt "${acked:-0}" ] && out="$out $pair"
    done

    SMART_WARN="${out# }"
}

# True when a disk's SMART values rose above what was acknowledged (slot, errors, Unraid id).
smart_bad() {
    smart_now_v "$1" "$2"
    smart_warnings_v "$SMART_NOW" "${CFG[smart_ack_${3//[^A-Za-z0-9]/_}]:-}"
    [ -n "$SMART_WARN" ]
}

# Brightness of a spun-down disk, in REPLY: standby_mode normal|dim|off|pulse, standby_level in %.
# "pulse" keeps the brightness; the bay breathes slowly instead (see daemon_run).
standby_brightness_v() {
    local brightness="$1"
    local level

    case "${CFG[standby_mode]:-dim}" in
        normal|pulse) REPLY="$brightness" ;;
        off) REPLY=0 ;;
        *)
            level="${CFG[standby_level]:-30}"
            brightness=$((brightness * level / 100))
            [ "$brightness" -lt 1 ] && brightness=1
            REPLY="$brightness"
            ;;
    esac
}

is_error_status() {
    case "$1" in
        DISK_INVALID|DISK_DSBL|DISK_DSBL_NEW|DISK_WRONG|DISK_NP_MISSING) return 0 ;;
    esac
    return 1
}

bays_json() {
    local bay
    local dev
    local serial
    local slot
    local disk_status
    local spundown
    local temp
    local errors
    local now
    local key
    local warnings
    local is_error
    local is_standby
    local temp_json
    local first=1

    disks_load
    devpaths_refresh

    printf '['
    for ((bay = 1; bay <= BAYS; bay++)); do
        bay_device_v "$bay"
        dev="$REPLY"
        serial=""
        slot=""
        disk_status=""
        spundown=0
        temp="-"
        errors=0
        TL_HOT=45
        TL_MAX=55
        now=""
        key=""
        warnings=""

        if [ -n "$dev" ]; then
            disk_serial_v "$dev"
            serial="$REPLY"
            # shellcheck disable=SC2086
            set -- ${DISKINFO[$dev]:-}
            slot="${1:-}"
            disk_status="${2:-}"
            spundown="${3:-0}"
            temp="${4:--}"
            errors="${5:-0}"
            temp_limits_v "${6:-1}" "${7:--}" "${8:--}"
            if [ -n "$slot" ]; then
                smart_now_v "$slot" "$errors"
                now="$SMART_NOW"
                key="smart_ack_${9:--}"
                key="${key//[^A-Za-z0-9]/_}"
                smart_warnings_v "$now" "${CFG[$key]:-}"
                warnings="$SMART_WARN"
            fi
        fi

        is_error=false
        is_error_status "$disk_status" && is_error=true
        is_standby=false
        [ "$spundown" = 1 ] && is_standby=true
        temp_json="$temp"
        [ "$temp" = "-" ] && temp_json=null

        [ "$first" -eq 1 ] || printf ','
        printf '{"bay":%s,"led":"disk%s","device":"%s","serial":"%s","slot":"%s","status":"%s","error":%s,"standby":%s,"temp":%s,"errors":%s,"temp_hot":%s,"temp_max":%s,"smart_now":"%s","smart_key":"%s","smart_warnings":"%s"}' \
            "$bay" "$bay" "$dev" "$serial" "$slot" "$disk_status" \
            "$is_error" "$is_standby" "$temp_json" "$errors" \
            "$TL_HOT" "$TL_MAX" "$now" "$key" "$warnings"
        first=0
    done
    printf ']\n'
}

# The interface behind the default route; a bridge is resolved to its uplink (e.g. br0 -> bond0).
network_device() {
    local dev=""
    local port
    local line

    # Unraid adds a second default route over shim-br0 (a macvlan for Docker): not the uplink.
    while read -r line; do
        if [[ $line =~ \ dev\ ([^\ ]+) ]] && [[ ${BASH_REMATCH[1]} != shim-* ]]; then
            dev="${BASH_REMATCH[1]}"
            break
        fi
    done < <(ip route show default 2>/dev/null)

    if [ -n "$dev" ] && [ -d "$SYS_NET/$dev/brif" ]; then
        for port in "$SYS_NET/$dev/brif"/*; do
            case "${port##*/}" in
                veth*|vnet*|tap*|docker*|virbr*|\*) ;;
                *) dev="${port##*/}"; break ;;
            esac
        done
    fi

    echo "$dev"
}

network_ok() {
    local dev="$1"
    local gateway=""
    local line
    local state=""

    read -r state 2>/dev/null < "$SYS_NET/$dev/operstate"
    [ "$state" = "up" ] || return 1

    while read -r line; do
        if [[ $line =~ ^default\ via\ ([^\ ]+) ]]; then
            gateway="${BASH_REMATCH[1]}"
            break
        fi
    done < <(ip route show default 2>/dev/null)
    [ -z "$gateway" ] || ping -c 1 -W 2 "$gateway" >/dev/null 2>&1
}

# Negotiated speed in Mbit/s, 0 when unknown (no link, or the driver doesn't say).
# A bond, bridge or VLAN reports an aggregate or a made-up value (a bridge with a VM
# says 10000), which isn't the speed of any cable: it follows its members down to the
# physical ports and uses the fastest one with a link.
link_speed() {
    local dev="$1"
    local depth="${2:-0}"
    local speed=""
    local best=0
    local file
    local member
    local members=0

    if [ "$depth" -lt 5 ]; then
        for file in "$SYS_NET/$dev"/lower_*; do
            [ -e "$file" ] || continue
            member="${file##*/lower_}"
            case "$member" in veth*|vnet*|tap*) continue ;; esac
            members=1
            speed="$(link_speed "$member" $((depth + 1)))"
            [ "$speed" -gt "$best" ] && best="$speed"
        done
    fi
    [ "$best" -gt 0 ] && { echo "$best"; return; }
    [ "$members" = 1 ] && { echo 0; return; }

    speed=""
    read -r speed 2>/dev/null < "$SYS_NET/$dev/speed"
    case "$speed" in
        ''|*[!0-9]*) echo 0 ;;
        *) [ "$speed" -gt 0 ] && echo "$speed" || echo 0 ;;
    esac
}

# Highest speed (Mbit/s) a port supports according to ethtool, 0 when unknown. What a port
# supports does not change while the NAS runs: asked once, then remembered in tmpfs.
MAXSPEED_CACHE="${UGREEN_MAXSPEED_CACHE:-/var/run/ugreen-nas-control.led.maxspeed}"

port_max_speed() {
    local name
    local speed

    command -v ethtool >/dev/null 2>&1 || { echo 0; return; }

    if [ -r "$MAXSPEED_CACHE" ]; then
        while read -r name speed; do
            [ "$name" = "$1" ] && { echo "$speed"; return; }
        done < "$MAXSPEED_CACHE"
    fi

    speed="$(ethtool "$1" 2>/dev/null | awk '
        /Supported link modes:/ { f = 1 }
        /Supported pause frame use:/ { f = 0 }
        f { while (match($0, /[0-9]+base/)) { n = substr($0, RSTART, RLENGTH - 4) + 0; if (n > m) m = n; $0 = substr($0, RSTART + RLENGTH) } }
        END { print m + 0 }')"
    [ "${speed:-0}" -gt 0 ] && printf '%s %s\n' "$1" "$speed" 2>/dev/null >> "$MAXSPEED_CACHE"
    echo "${speed:-0}"
}

# The physical network ports (they have a /device link; bonds, bridges and veths don't):
# [{"name": "eth0", "link": true, "speed": 2500, "max": 10000}, ...]
network_ports_json() {
    local dir
    local name
    local carrier
    local speed
    local link
    local out=""

    for dir in "$SYS_NET"/*; do
        [ -e "$dir/device" ] || continue
        name="${dir##*/}"
        case "$name" in
            lo|veth*|vnet*|tap*|docker*|virbr*|wl*) continue ;;
        esac

        carrier=""
        speed=""
        read -r carrier 2>/dev/null < "$dir/carrier"
        read -r speed 2>/dev/null < "$dir/speed"
        case "$speed" in ''|*[!0-9]*) speed=0 ;; esac
        [ "$carrier" = "1" ] || speed=0
        link=false
        [ "$carrier" = "1" ] && link=true

        out="$out, {\"name\": \"$name\", \"link\": $link, \"speed\": $speed, \"max\": $(port_max_speed "$name")}"
    done

    printf '[%s]' "${out#, }"
}

# "R G B" for a speed in Mbit/s from the saved colours, in REPLY.
speed_color_v() {
    local speed="$1"
    local step
    local use=10

    for step in $SPEED_STEPS; do
        [ "$speed" -ge "$step" ] && use="$step"
    done

    REPLY="${CFG[netdev_speed_$use]:-}"
    [ -n "$REPLY" ] || REPLY="$(default_speed_color "$use")"
}

speed_colors_json() {
    local step
    local out=""

    for step in $SPEED_STEPS; do
        out="$out, \"$step\": \"${CFG[netdev_speed_$step]:-$(default_speed_color "$step")}\""
    done
    printf '{%s}' "${out#, }"
}

log() {
    logger -t ugreen-led-control "$1" 2>/dev/null || echo "$1"
}

# "steady|R G B|brightness", "breath|R G B|brightness", "pulse|R G B|brightness"
# (slow breathing of a disk in standby) or "off".
show_led() {
    local led="$1"
    local wanted="$2"
    local mode="${wanted%%|*}"
    local rest="${wanted#*|}"

    if [ "$wanted" = "off" ]; then
        tool set "$led" off >/dev/null 2>&1
        return
    fi

    # shellcheck disable=SC2086
    tool set "$led" color ${rest%|*} >/dev/null 2>&1
    tool set "$led" brightness "${rest#*|}" >/dev/null 2>&1

    if [ "$mode" = "breath" ]; then
        tool set "$led" breath 1500 1500 >/dev/null 2>&1
    elif [ "$mode" = "pulse" ]; then
        tool set "$led" breath 3000 3000 >/dev/null 2>&1
    else
        tool set "$led" on >/dev/null 2>&1
    fi
}

# What the controller reports for each LED ("<mode> <brightness> <R> <G> <B> <on_ms> <off_ms>"),
# from one `get all`. False when the controller does not answer.
declare -A LEDSTATE=()

leds_read() {
    local out
    local name
    local rest

    LEDSTATE=()
    out="$(tool --plain get all 2>/dev/null)" || return 1
    while read -r name rest; do
        [ -n "$name" ] && LEDSTATE[$name]="$rest"
    done <<< "$out"
    [ "${#LEDSTATE[@]}" -gt 0 ]
}

# Does the LED look like the wanted state ("steady|R G B|brightness", "breath|...", "pulse|..." or "off")?
# A running activity blink counts as right: it is the daemon's own doing.
led_matches() {
    local wanted="$2"
    local is_blinking="$3"
    local mode brightness r g b on off
    local kind="${wanted%%|*}"
    local rest="${wanted#*|}"

    [ -n "${LEDSTATE[$1]:-}" ] || return 1
    read -r mode brightness r g b on off <<< "${LEDSTATE[$1]}"

    [ "$wanted" = "off" ] && [ "$mode" = "off" ] && return 0
    [ "$wanted" = "off" ] && return 1
    [ "$is_blinking" -eq 1 ] && [ "$mode" = "blink" ] && return 0

    [ "$r $g $b" = "${rest%|*}" ] && [ "$brightness" = "${rest#*|}" ] || return 1

    case "$kind" in
        steady) [ "$mode" = "on" ] ;;
        breath) [ "$mode" = "breath" ] && [ "$on" = 1500 ] && [ "$off" = 1500 ] ;;
        pulse) [ "$mode" = "breath" ] && [ "$on" = 3000 ] && [ "$off" = 3000 ] ;;
        *) return 1 ;;
    esac
}

daemon_run() {
    local bays="$BAYS"
    local tick=0
    local bay
    local dev
    local reads
    local writes
    local rest
    local wanted
    local error_color
    local net_dev
    local net_ok=1
    local net_wanted=""
    local net_counter=""
    local net_blinking=0
    local net_status=activity
    local net_speed=0
    local speed_on=0
    local rx
    local tx
    local night=0
    local brightness
    local sync_color
    local smart_on
    local smart_color
    local error_on
    local activity_on
    local temp_mode
    local standby_mode
    local look
    local sleep_fd
    local -a devices=()
    local -a applied=()
    local -a counters=()
    local -a blinking=()

    net_dev="$(network_device)"

    trap 'log "status daemon stopped"; exit 0' TERM INT
    # A pipe nobody writes to: `read -t` on it waits without starting a sleep process.
    # If that fails the loop falls back to an external sleep, so the daemon never dies on it.
    { exec {sleep_fd}<> <(:); } 2>/dev/null || sleep_fd=

    # Link and speed right away, so the first 5 s don't show the wrong colour.
    if [ -n "$net_dev" ]; then
        network_ok "$net_dev" && net_ok=1 || net_ok=0
        net_speed="$(link_speed "$net_dev")"
    fi

    log "status daemon started (bays: $bays, network: ${net_dev:-none})"

    while :; do
        if [ $((tick % 25)) -eq 0 ]; then
            # Two monitors would overwrite each other forever; leave the LEDs to the other one.
            if [ $((tick % 150)) -eq 0 ] && foreign_monitor_running; then
                log "ugreenleds-driver monitor is running, status daemon exits"
                rm -f "$PIDFILE"
                exit 0
            fi

            # Every 5 s: saved settings (parsed again only when the file changed), which disk is where,
            # Unraid's disk status. All of it from files and memory, no helper processes.
            cfg_load
            disks_load
            devpaths_refresh
            DYN_LOADED=

            error_color="${CFG[disk_error_color]:-$DEFAULT_ERROR_COLOR}"

            night=0
            is_night && night=1

            # Parity check / rebuild: array disks breathe in the sync colour.
            SYNC=""
            [ "${CFG[sync_enabled]:-}" != "0" ] && sync_state_v
            sync_color="${CFG[sync_color]:-$DEFAULT_SYNC_COLOR}"
            smart_on="${CFG[smart_enabled]:-1}"
            error_on="${CFG[error_enabled]:-1}"
            activity_on="${CFG[activity_enabled]:-1}"
            smart_color="${CFG[smart_color]:-$DEFAULT_SMART_COLOR}"
            temp_mode="${CFG[disk_color_mode]:-own}"
            standby_mode="${CFG[standby_mode]:-dim}"
            netdev_status_v
            net_status="$REPLY"
            speed_on=0
            [ "${CFG[netdev_speed_enabled]:-}" = "1" ] && speed_on=1

            # Every 30 s the LEDs are compared with what the controller says and only the ones that
            # differ are written again (a manual Test, an effect, a controller reset). Writing
            # everything would restart the breathing of every standby bay each time.
            # A manual network LED is written once and then left alone (its effect may run).
            if [ $((tick % 150)) -eq 0 ] && [ "$tick" -gt 0 ]; then
                if leds_read; then
                    for ((bay = 1; bay <= bays; bay++)); do
                        [ -n "${applied[bay]:-}" ] && [ "${applied[bay]}" != "identify" ] \
                            && ! led_matches "disk$bay" "${applied[bay]}" "${blinking[bay]:-0}" && unset 'applied[bay]'
                    done
                    [ -n "$net_wanted" ] && [ "$net_wanted" != "manual" ] \
                        && ! led_matches netdev "$net_wanted" "$net_blinking" && net_wanted=""
                else
                    applied=()
                    [ "$net_wanted" = "manual" ] || net_wanted=""
                fi
            fi

            for ((bay = 1; bay <= bays; bay++)); do
                bay_device_v "$bay"
                dev="$REPLY"
                devices[bay]="$dev"

                # Being identified: hands off; once it ends, the next round writes it again.
                if [ -e "${IDENTIFY_PREFIX}disk$bay" ]; then
                    applied[bay]="identify"
                    continue
                fi

                effective_brightness_v "${CFG[disk${bay}_brightness]:-255}" "$night"
                brightness="$REPLY"
                look="steady"
                set --
                if [ -n "$dev" ]; then
                    # shellcheck disable=SC2086
                    set -- ${DISKINFO[$dev]:-}
                    if [ "${3:-0}" = "1" ]; then
                        standby_brightness_v "$brightness"
                        brightness="$REPLY"
                        [ "$standby_mode" = "pulse" ] && look="pulse"
                    fi
                fi

                # Error > SMART warning > parity check > temperature or own colour.
                if [ -z "$dev" ] || [ "$brightness" -eq 0 ]; then
                    wanted="off"
                elif [ "$error_on" = "1" ] && is_error_status "${2:-}"; then
                    wanted="steady|$error_color|$brightness"
                elif [ "$smart_on" = "1" ] && [ -n "${1:-}" ] && smart_bad "$1" "${5:-0}" "${9:--}"; then
                    wanted="steady|$smart_color|$brightness"
                elif [ -n "$SYNC" ] && [ -n "${1:-}" ]; then
                    wanted="breath|$sync_color|$brightness"
                elif [ "$temp_mode" = "temperature" ] && [ "${4:--}" != "-" ]; then
                    temp_limits_v "${6:-1}" "${7:--}" "${8:--}"
                    wanted="$look|$(temp_color "$4" "$TL_HOT" "$TL_MAX")|$brightness"
                else
                    wanted="$look|${CFG[disk${bay}_color]:-$DEFAULT_DISK_COLOR}|$brightness"
                fi

                if [ "${applied[bay]:-}" != "$wanted" ]; then
                    show_led "disk$bay" "$wanted"
                    applied[bay]="$wanted"
                    blinking[bay]=0
                fi
            done

            if [ "$net_status" = "manual" ]; then
                # Hand it back to the saved manual look once.
                if [ "$net_wanted" != "manual" ]; then
                    [ "$net_blinking" -eq 1 ] && tool set netdev on >/dev/null 2>&1
                    apply_led netdev >/dev/null 2>&1
                    [ "$night" -eq 1 ] && apply_night netdev
                    net_wanted="manual"
                    net_blinking=0
                fi
            elif [ -n "$net_dev" ]; then
                effective_brightness_v "${CFG[netdev_brightness]:-255}" "$night"
                brightness="$REPLY"

                if [ "$brightness" -eq 0 ]; then
                    wanted="off"
                elif [ "$net_ok" -eq 1 ] && [ "$speed_on" = "1" ] && [ "$net_speed" -gt 0 ]; then
                    speed_color_v "$net_speed"
                    wanted="steady|$REPLY|$brightness"
                elif [ "$net_ok" -eq 1 ]; then
                    wanted="steady|${CFG[netdev_color]:-$DEFAULT_NETDEV_COLOR}|$brightness"
                else
                    wanted="steady|$error_color|$brightness"
                fi

                if [ "$net_wanted" != "$wanted" ]; then
                    show_led netdev "$wanted"
                    net_wanted="$wanted"
                    net_blinking=0
                fi

                # Switched from activity to link while it was blinking.
                if [ "$net_status" = "link" ] && [ "$net_blinking" -eq 1 ]; then
                    tool set netdev on >/dev/null 2>&1
                    net_blinking=0
                fi
            fi
        fi

        # Every 30 s: link and gateway.
        if [ $((tick % 150)) -eq 1 ] && [ -n "$net_dev" ]; then
            if network_ok "$net_dev"; then
                net_ok=1
            else
                net_ok=0
            fi
            net_speed="$(link_speed "$net_dev")"
        fi

        # Every 0.2 s: blink while the read/write counters of a disk move.
        for ((bay = 1; bay <= bays; bay++)); do
            dev="${devices[bay]:-}"
            [ -n "$dev" ] || continue
            # Dark, breathing during a parity check or in standby, or being identified: no activity blink.
            case "${applied[bay]:-}" in
                off|breath\|*|pulse\|*|identify) continue ;;
            esac
            [ -e "${IDENTIFY_PREFIX}disk$bay" ] && continue

            # Blinking switched off: a blink that is still running ends here.
            if [ "$activity_on" = "0" ]; then
                if [ "${blinking[bay]:-0}" -eq 1 ]; then
                    tool set "disk$bay" on >/dev/null 2>&1
                    blinking[bay]=0
                fi
                continue
            fi

            read -r reads _ _ _ writes rest 2>/dev/null < "$SYS_BLOCK/$dev/stat" || continue

            if [ -n "${counters[bay]:-}" ] && [ "${counters[bay]}" != "$reads $writes" ]; then
                if [ "${blinking[bay]:-0}" -eq 0 ]; then
                    tool set "disk$bay" blink "$ACTIVITY_ON_MS" "$ACTIVITY_OFF_MS" >/dev/null 2>&1
                    blinking[bay]=1
                fi
            elif [ "${blinking[bay]:-0}" -eq 1 ]; then
                tool set "disk$bay" on >/dev/null 2>&1
                blinking[bay]=0
            fi
            counters[bay]="$reads $writes"
        done

        # The same for network traffic, unless it should only show the link.
        if [ -n "$net_dev" ] && [ "$net_status" = "activity" ] \
            && [ "$net_wanted" != "off" ] && [ "$net_wanted" != "manual" ] \
            && read -r rx 2>/dev/null < "$SYS_NET/$net_dev/statistics/rx_bytes" \
            && read -r tx 2>/dev/null < "$SYS_NET/$net_dev/statistics/tx_bytes"; then

            if [ -n "$net_counter" ] && [ "$net_counter" != "$rx $tx" ]; then
                if [ "$net_blinking" -eq 0 ]; then
                    tool set netdev blink "$ACTIVITY_ON_MS" "$ACTIVITY_OFF_MS" >/dev/null 2>&1
                    net_blinking=1
                fi
            elif [ "$net_blinking" -eq 1 ]; then
                tool set netdev on >/dev/null 2>&1
                net_blinking=0
            fi
            net_counter="$rx $tx"
        fi

        if [ -n "$sleep_fd" ]; then read -r -t 0.2 -u "$sleep_fd" _ || true; else sleep 0.2 || true; fi
        tick=$((tick + 1))
    done
}

daemon_running() {
    local pid

    [ -f "$PIDFILE" ] && read -r pid 2>/dev/null < "$PIDFILE" && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

daemon_start() {
    if daemon_running; then
        echo "Status daemon is already running."
        return 0
    fi

    if foreign_monitor_running; then
        echo "ERROR: The LED monitor of ugreenleds-driver is running; uninstall that plugin first." >&2
        return 1
    fi

    setsid "$(readlink -f "$0")" daemon run </dev/null >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    echo "Status daemon started."
}

daemon_stop() {
    if daemon_running; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
    fi
    rm -f "$PIDFILE"

    # Hand the LEDs back to the saved manual settings.
    apply_config >/dev/null

    echo "Status daemon stopped."
}

daemon_command() {
    case "${1:-status}" in
        start) daemon_start ;;
        stop) daemon_stop ;;
        restart) daemon_stop >/dev/null; daemon_start ;;
        run) daemon_run ;;
        status)
            if daemon_running; then
                echo "running (pid $(cat "$PIDFILE"))"
            else
                echo "stopped"
                return 3
            fi
            ;;
        *) echo "Usage: $0 daemon start|stop|restart|status|run" >&2; return 2 ;;
    esac
}

# ============================================================
# Software effects (rainbow, temperature)
# ============================================================

# fx_name rainbow|temperature, fx_leds "power,disk1,...", fx_speed 0-4,
# fx_reverse 0|1, fx_idle 0|1 – run by ugreen-led-i2c until stopped.
fx_running() {
    local pid

    [ -f "$FX_PIDFILE" ] && read -r pid 2>/dev/null < "$FX_PIDFILE" && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

fx_stop() {
    if fx_running; then
        kill "$(cat "$FX_PIDFILE")" 2>/dev/null
    fi
    rm -f "$FX_PIDFILE"
}

fx_start() {
    local name
    local leds
    local -a args=()

    name="${CFG[fx_name]:-}"
    if [ -z "$name" ]; then
        echo "No effect configured."
        return 0
    fi

    fx_stop

    leds="${CFG[fx_leds]:-power}"
    args+=(--speed "${CFG[fx_speed]:-2}")
    [ "${CFG[fx_reverse]:-}" = "1" ] && args+=(--reverse)
    [ "${CFG[fx_idle]:-}" = "1" ] && args+=(--idle-only)

    setsid "$LED_TOOL" "${args[@]}" effect "$name" "$leds" </dev/null >/dev/null 2>"$FX_LOG" &
    echo $! > "$FX_PIDFILE"

    # A missing temperature sensor ends the process right away.
    sleep 0.5
    if ! fx_running; then
        rm -f "$FX_PIDFILE"
        echo "ERROR: Effect '$name' did not start: $(head -n 1 "$FX_LOG" 2>/dev/null)" >&2
        return 1
    fi

    echo "Effect $name started on $leds."
}

fx_command() {
    case "${1:-status}" in
        start) fx_start ;;
        stop) fx_stop; echo "Effect stopped." ;;
        restart) fx_start ;;
        status)
            if fx_running; then
                echo "running: ${CFG[fx_name]:-} on ${CFG[fx_leds]:-}"
            else
                echo "stopped"
                return 3
            fi
            ;;
        *) echo "Usage: $0 fx start|stop|restart|status" >&2; return 2 ;;
    esac
}

# ============================================================
# Identify a bay
# ============================================================

# While "<prefix><led>" exists, the bay blinks white and the status daemon
# leaves it alone. The file holds a token and the LED's state from before.
identify_start() {
    local led="$1"
    local seconds="${2:-30}"
    local marker="$IDENTIFY_PREFIX$led"
    local snapshot
    local token="$RANDOM$RANDOM"

    case "$led" in
        disk[1-8]) require_led "$led" || return 1 ;;
        *) echo "ERROR: Only bay LEDs (disk1..diskN) can be identified." >&2; return 1 ;;
    esac
    case "$seconds" in
        ''|*[!0-9]*) echo "ERROR: Seconds must be a number." >&2; return 1 ;;
    esac

    # Pressed again while blinking: keep the original state, renew the timer.
    if [ -f "$marker" ]; then
        snapshot="$(sed -n 2p "$marker")"
    else
        snapshot="$(led_line "$led")" || return 1
    fi
    printf '%s\n%s\n' "$token" "$snapshot" > "$marker"

    tool set "$led" color 255 255 255 &&
        tool set "$led" brightness 255 &&
        tool set "$led" blink 100 100 || return 1

    setsid bash -c 'sleep "$1"; exec "$2" identify-stop "$3" "$4"' _ \
        "$seconds" "$(readlink -f "$0")" "$led" "$token" </dev/null >/dev/null 2>&1 &

    echo "Identifying $led for $seconds s."
}

# Without a token it always stops; the timer passes its token, so an older
# timer doesn't end a renewed identify early.
identify_stop() {
    local led="$1"
    local token="${2:-}"
    local marker="$IDENTIFY_PREFIX$led"
    local name mode brightness r g b on off

    [ -f "$marker" ] || return 0
    [ -z "$token" ] || [ "$(sed -n 1p "$marker")" = "$token" ] || return 0

    read -r name mode brightness r g b on off < <(sed -n 2p "$marker")
    rm -f "$marker"

    tool set "$led" color "$r" "$g" "$b" >/dev/null 2>&1
    tool set "$led" brightness "$brightness" >/dev/null 2>&1
    case "$mode" in
        off|on) tool set "$led" "$mode" >/dev/null 2>&1 ;;
        blink|breath) tool set "$led" "$mode" "$on" "$off" >/dev/null 2>&1 ;;
    esac

    echo "Stopped identifying $led."
}

identifying_leds() {
    local marker
    local first=1

    printf '['
    for marker in "$IDENTIFY_PREFIX"disk*; do
        [ -e "$marker" ] || continue
        [ "$first" -eq 1 ] || printf ', '
        printf '"%s"' "${marker#"$IDENTIFY_PREFIX"}"
        first=0
    done
    printf ']'
}

# ============================================================
# Commands
# ============================================================

need() {
    [ "$1" -eq "$2" ] || {
        echo "Usage: $0 $3" >&2
        exit 2
    }
}

cfg_load

# Every command except help talks to the controller (tests bring their own tool).
if [ -z "${UGREEN_LED_I2C:-}" ]; then
    case "${1:-help}" in
        help|-h|--help) ;;
        *) has_smbus || ensure_smbus ;;
    esac
fi

case "${1:-help}" in
    dxp480t) dxp480t_apply ;;
    smbus)
        if ensure_smbus; then
            echo "SMBus adapter: $(grep -H -e '^SMBus I801' -e '^Synopsys DesignWare' /sys/bus/i2c/devices/i2c-*/name 2>/dev/null || echo 'AMD DesignWare I2C (AMDI0010) via /dev/mem')"
        else
            echo "ERROR: No SMBus I801 / DesignWare adapter after loading its driver. Kernel messages:" >&2
            dmesg | grep -iE 'i801|smbus|designware' | tail -n 10 >&2
            exit 1
        fi
        ;;
    status) status ;;
    list) list_leds ;;
    all) all_leds ;;
    apply) apply_config ;;
    bays) bays_json ;;
    daemon) daemon_command "${2:-status}" ;;
    schedule) [ -e "$SHUTDOWN_MARK" ] || { schedule_tick "${2:-}"; alert_tick; } ;;
    alerts) [ -e "$SHUTDOWN_MARK" ] || alert_tick "${2:-}" ;;
    shutdown) shutdown_signal "${2:-}" ;;
    power-restore) restore_power; alert_tick --force ;;
    fx) fx_command "${2:-status}" ;;
    identify) [ $# -ge 2 ] || { echo "Usage: $0 identify <diskN> [seconds]" >&2; exit 2; }; identify_start "$2" "${3:-30}" ;;
    identify-stop) [ $# -ge 2 ] || { echo "Usage: $0 identify-stop <diskN>" >&2; exit 2; }; identify_stop "$2" "${3:-}" ;;

    get) need $# 2 "get <led>"; get_status "$2" ;;
    on) need $# 2 "on <led>"; set_on "$2" ;;
    off) need $# 2 "off <led>"; set_off "$2" ;;
    stop) need $# 2 "stop <led>"; stop_effect "$2" ;;
    brightness) need $# 3 "brightness <led> <0-255>"; set_brightness "$2" "$3" ;;
    color) need $# 5 "color <led> <R> <G> <B>"; set_color "$2" "$3" "$4" "$5" ;;
    blink) need $# 4 "blink <led> <on_ms> <off_ms>"; set_effect blink "$2" "$3" "$4" ;;
    breath) need $# 4 "breath <led> <on_ms> <off_ms>"; set_effect breath "$2" "$3" "$4" ;;

    help|--help|-h) usage ;;

    *)
        echo "ERROR: Unknown command '$1'." >&2
        usage
        exit 2
        ;;
esac

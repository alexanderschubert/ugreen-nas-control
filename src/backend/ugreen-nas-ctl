#!/bin/bash
#
# UGREEN NAS Control: starts and stops the fan daemon (ugreen-nas-fan daemon),
# which drives the fans after the curves in fan.cfg.
#
set -u

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
FAN_TOOL="${UGREEN_NAS_FAN:-$HERE/ugreen-nas-fan}"
PIDFILE="${UGREEN_FAN_PIDFILE:-/var/run/ugreen-nas-control.pid}"
ERRLOG="${UGREEN_FAN_ERRLOG:-/var/run/ugreen-nas-control.err}"
FAN_CFG="${UGREEN_FAN_CONFIG:-/boot/config/plugins/ugreen-nas-control/fan.cfg}"
PUB_PIDFILE="${UGREEN_PUB_PIDFILE:-/var/run/ugreen-nas-control-mqtt.pid}"
PUB_LOG="${UGREEN_PUB_LOG:-/var/log/ugreen-nas-control-mqtt.log}"

LED_DIR="${UGREEN_LED_DIR:-$HERE/../led/backend}"
LED_CTL="${UGREEN_LED_CTL:-$LED_DIR/ugreen-led-ctl}"
LED_I2C="${UGREEN_LED_I2C:-$LED_DIR/ugreen-led-i2c}"
LED_FLAG="${UGREEN_LED_FLAG:-/boot/config/plugins/ugreen-nas-control/led.enabled}"
LED_CRON="${UGREEN_LED_CRON:-/boot/config/plugins/ugreen-nas-control/ugreen-nas-control.cron}"
LED_CFG="${UGREEN_LED_CFG:-/boot/config/plugins/ugreen-nas-control/leds.cfg}"
LED_IMPORT_SRC="${UGREEN_LED_IMPORT_SRC:-/boot/config/plugins/ugreen-led-control/leds.cfg}"
DMI_DIR="${UGREEN_DMI:-/sys/class/dmi/id}"
PLUGINS_BOOT="${UGREEN_PLUGINS_BOOT:-/boot/config/plugins}"
PLUGINS_WEB="${UGREEN_PLUGINS_WEB:-/usr/local/emhttp/plugins}"
PROC_MODULES="${UGREEN_PROC_MODULES:-/proc/modules}"
UPDATE_CRON="${UGREEN_UPDATE_CRON:-/usr/local/sbin/update_cron}"

usage() {
    cat <<USAGE
Usage:
  ugreen-nas-ctl start|stop|restart|status   fan daemon (also runs in mode "bios",
                                             where it only watches) and, if switched on, the MQTT publisher
  ugreen-nas-ctl mqtt-start|mqtt-stop|mqtt-status
                                             the MQTT publisher alone (mqtt_enabled="1" in fan.cfg)
  ugreen-nas-ctl led-status                  LED part as JSON: enabled, supported, conflict
  ugreen-nas-ctl led-enable|led-disable      switch the LED part on or off
  ugreen-nas-ctl led-import                  take over the settings of UGREEN LED Control
  ugreen-nas-ctl led-boot                    bring the LEDs up (install, boot), if enabled
USAGE
}

#
# LEDs: the built-in LED control (led/), off until it is switched on. Every UGREEN DX/DXP/iDX,
# and not next to the other LED plugins, which write the same LEDs.
#

led_model() {
    cat "$DMI_DIR/product_name" 2>/dev/null | head -n 1
}

# Why the LEDs cannot be used here: model, driver, module; empty if nothing is in the way.
led_blocker() {
    case "$(led_model)" in
        # UGREEN's own models, as UGREEN LED Control knew them: the controller is the same across DX/DXP/iDX.
        DXP*|DX[0-9]*|iDX*) ;;
        *) echo model; return ;;
    esac
    if [ -e "$PLUGINS_BOOT/ugreenleds-driver.plg" ] || [ -d "$PLUGINS_WEB/ugreenleds-driver" ]; then
        echo driver; return
    fi
    if grep -q '^led_ugreen ' "$PROC_MODULES" 2>/dev/null; then
        echo module; return
    fi
}

led_enabled() {
    [ -f "$LED_FLAG" ]
}

# Models UGREEN LED Control has verified or had confirmed by users; every other model works after the
# same protocol but with a guessed bay order (or, like the iDX6011, from reports of other plugins only).
led_untested() {
    case "$(led_model)" in
        DXP6800*|DXP8800*|DXP4800*|DX4600*|DX4700*|DXP2800*|DXP480T*) echo false ;;
        *) echo true ;;
    esac
}

# The installed plugin UGREEN LED Control is no obstacle: both run on their own and use the same
# LED tool with a shared bus lock. Only the last one to write wins, which the page points out.
led_warning() {
    if [ -e "$PLUGINS_BOOT/ugreen-led-control.plg" ] || [ -d "$PLUGINS_WEB/ugreen-led-control" ]; then
        echo standalone
    fi
}

# The settings of an installed UGREEN LED Control that this plugin does not have yet (or has differently).
led_import_available() {
    [ -s "$LED_IMPORT_SRC" ] && ! cmp -s "$LED_IMPORT_SRC" "$LED_CFG"
}

led_status() {
    local blocker model

    blocker="$(led_blocker)"
    model="$(led_model)"
    printf '{"enabled": %s, "supported": %s, "blocker": "%s", "warning": "%s", "untested": %s, "import_available": %s, "model": "%s"}\n' \
        "$(led_enabled && echo true || echo false)" \
        "$([ "$blocker" = model ] && echo false || echo true)" \
        "$blocker" "$(led_warning)" "$(led_untested)" "$(led_import_available && echo true || echo false)" "$(printf '%s' "$model" | tr -d '"\\')"
}

# Earlier versions kept the daemon's pid in the standalone plugin's files. Such a
# process is ours only if it runs from our own led/ directory; the standalone plugin's is left alone.
led_stop_legacy() {
    local pidfile pid

    for pidfile in ${UGREEN_LED_LEGACY_PIDS:-/var/run/ugreen-led-control.pid /var/run/ugreen-led-control-fx.pid}; do
        pid="$(cat "$pidfile" 2>/dev/null)"
        [ -n "$pid" ] || continue
        if tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -qF "$LED_DIR/"; then
            kill "$pid" 2>/dev/null
            rm -f "$pidfile"
        fi
    done
}

# Only this plugin's own LED daemon and effect (their pidfiles are named after this plugin);
# nothing happens when they are not running.
led_stop() {
    led_stop_legacy
    if [ -x "$LED_CTL" ]; then
        "$LED_CTL" fx stop >/dev/null 2>&1
        "$LED_CTL" daemon stop >/dev/null 2>&1
    fi
}

# What UGREEN LED Control does at install and boot: drivers, saved settings, status daemon,
# night mode, effect. Runs only with the switch on and nothing in the way.
led_boot() {
    local blocker

    led_enabled || return 0

    blocker="$(led_blocker)"
    if [ -n "$blocker" ]; then
        echo "LEDs not started: $blocker"
        return 1
    fi

    modprobe i2c_i801 2>/dev/null
    modprobe i2c-dev 2>/dev/null

    if "$LED_I2C" probe >/dev/null 2>&1; then
        "$LED_CTL" apply

        # Restart also replaces a daemon still running the previous version's code.
        if grep -qx 'mode="status"' "$LED_CFG" 2>/dev/null; then
            "$LED_CTL" daemon restart 2>&1
        fi

        # Night mode right away; afterwards cron checks it every minute.
        "$LED_CTL" schedule --force

        # Rainbow/temperature effect, if one was chosen.
        if grep -q '^fx_name="[a-z]' "$LED_CFG" 2>/dev/null; then
            "$LED_CTL" fx start 2>&1
        fi
    else
        echo "WARNING: The LED controller does not answer on the SMBus; no LEDs available."
        "$LED_CTL" smbus 2>&1
    fi

    mkdir -p "$(dirname "$LED_CRON")"
    echo "* * * * * $LED_CTL schedule >/dev/null 2>&1" > "$LED_CRON"
    "$UPDATE_CRON" 2>/dev/null
    return 0
}

led_enable() {
    local blocker

    blocker="$(led_blocker)"
    if [ -n "$blocker" ]; then
        echo "ERROR: The LEDs cannot be switched on: $blocker" >&2
        return 1
    fi

    mkdir -p "$(dirname "$LED_FLAG")"
    : > "$LED_FLAG"

    # First use with an installed UGREEN LED Control: start with its settings instead of the defaults.
    if [ ! -e "$LED_CFG" ] && [ -s "$LED_IMPORT_SRC" ]; then
        cp "$LED_IMPORT_SRC" "$LED_CFG"
        echo "Took over the settings of UGREEN LED Control."
    fi
    led_boot
}

# Take over the settings of UGREEN LED Control (colours, effects, status mode, night mode, ...).
# What this plugin had is kept as leds.cfg.bak.
led_import() {
    if [ ! -s "$LED_IMPORT_SRC" ]; then
        echo "ERROR: No settings of UGREEN LED Control found." >&2
        return 1
    fi

    mkdir -p "$(dirname "$LED_CFG")"
    [ -e "$LED_CFG" ] && cp "$LED_CFG" "$LED_CFG.bak"
    cp "$LED_IMPORT_SRC" "$LED_CFG"

    # Put the new settings on the LEDs, if this part is running.
    led_enabled && led_boot
    echo "Took over the settings of UGREEN LED Control."
    return 0
}

led_disable() {
    led_stop
    rm -f "$LED_FLAG" "$LED_CRON"
    "$UPDATE_CRON" 2>/dev/null
    echo "LEDs switched off; they keep their last state until the next power cycle."
}

running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

# fan_control="0" in fan.cfg: this plugin must not touch the fan chip (another plugin or the BIOS runs the fans).
fan_off() {
    [ "$(sed -n 's/^fan_control="\(.*\)"$/\1/p' "$FAN_CFG" 2>/dev/null | tail -n 1)" = 0 ]
}

fan_start() {
    local probe

    if fan_off; then
        echo "Fan control is switched off in the settings."
        return 0
    fi

    if running; then
        echo "Fan daemon is already running."
        return 0
    fi

    if ! probe="$("$FAN_TOOL" probe 2>&1)"; then
        echo "ERROR: $(printf '%s' "$probe" | sed -n 's/.*"error": "\(.*\)".*/\1/p' | grep . || echo "$probe")" >&2
        return 1
    fi

    setsid "$FAN_TOOL" daemon </dev/null >/dev/null 2>"$ERRLOG" &
    echo $! > "$PIDFILE"

    # A daemon that cannot start (no BIOS snapshot, no ports) ends at once.
    sleep 0.5
    if ! running; then
        rm -f "$PIDFILE"
        echo "ERROR: Fan daemon did not start: $(head -n 1 "$ERRLOG" 2>/dev/null)" >&2
        return 1
    fi

    echo "Fan daemon started."
}

# The daemon writes the BIOS fan settings back on SIGTERM; wait for that.
fan_stop() {
    local pid
    local i

    if running; then
        pid="$(cat "$PIDFILE")"
        kill "$pid" 2>/dev/null
        for i in $(seq 1 50); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
    fi
    rm -f "$PIDFILE"

    echo "Fan daemon stopped."
}

# The MQTT publisher (ugreen-nas-fan publish): runs only with mqtt_enabled="1" in fan.cfg, apart from the
# fan daemon, so it also runs where the fans are not controlled.
pub_enabled() {
    [ "$(sed -n 's/^mqtt_enabled="\(.*\)"$/\1/p' "$FAN_CFG" 2>/dev/null | tail -n 1)" = 1 ]
}

pub_running() {
    [ -f "$PUB_PIDFILE" ] && kill -0 "$(cat "$PUB_PIDFILE" 2>/dev/null)" 2>/dev/null
}

pub_start() {
    pub_enabled || return 0
    pub_running && return 0

    : > "$PUB_LOG" 2>/dev/null
    setsid "$FAN_TOOL" publish </dev/null >>"$PUB_LOG" 2>&1 &
    echo $! > "$PUB_PIDFILE"

    # It ends at once without a host in the settings.
    sleep 0.5
    if ! pub_running; then
        rm -f "$PUB_PIDFILE"
        echo "ERROR: MQTT publisher did not start: $(tail -n 1 "$PUB_LOG" 2>/dev/null)" >&2
        return 1
    fi

    echo "MQTT publisher started."
}

pub_stop() {
    local pid i

    if pub_running; then
        pid="$(cat "$PUB_PIDFILE")"
        kill "$pid" 2>/dev/null
        for i in $(seq 1 30); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
    fi
    rm -f "$PUB_PIDFILE"
}

# The publisher's failure must not stop the fans from starting, nor the other way round.
start() {
    local rc=0

    fan_start || rc=$?
    pub_start || true
    return $rc
}

stop() {
    pub_stop
    fan_stop
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop >/dev/null; start ;;
    mqtt-start) pub_start ;;
    mqtt-stop) pub_stop; echo "MQTT publisher stopped." ;;
    mqtt-status)
        if pub_running; then
            echo "running (pid $(cat "$PUB_PIDFILE"))"
        else
            echo "stopped"
            exit 3
        fi
        ;;
    status)
        if running; then
            echo "running (pid $(cat "$PIDFILE"))"
        else
            echo "stopped"
            exit 3
        fi
        ;;
    led-status) led_status ;;
    led-enable) led_enable ;;
    led-import) led_import ;;
    led-disable) led_disable ;;
    led-boot) led_boot ;;
    led-stop) led_stop ;;
    *) usage; exit 2 ;;
esac

<!-- ========================================================= -->
<!-- INSTALL -->
<!-- ========================================================= -->

<!-- Entities are not expanded inside CDATA, so the scripts get them as variables first. -->
<FILE Run="/bin/bash">
<INLINE>
NAME="&name;"
VERSION="&version;"
BOOT_DIR="&bootDIR;"
SRC_DIR="&srcDIR;"
<![CDATA[

PLUGIN_DIR="/usr/local/emhttp/plugins/${NAME}"

log() {
    echo "[UGREEN NAS Control] $1"
}

log "Installing ${VERSION} on kernel $(uname -r)"

# The daemon of the previous version hands the fans back to the BIOS values first.
# The LED daemon and an LED effect of the previous version must not keep writing either.
if [ -x "${PLUGIN_DIR}/backend/ugreen-nas-ctl" ]; then
    "${PLUGIN_DIR}/backend/ugreen-nas-ctl" stop >/dev/null 2>&1
    "${PLUGIN_DIR}/backend/ugreen-nas-ctl" led-stop >/dev/null 2>&1
fi

#
# Web interface and backend
#

rm -rf "${PLUGIN_DIR}"
mkdir -p "${PLUGIN_DIR}"
cp -r "${SRC_DIR}/." "${PLUGIN_DIR}/"
chmod 755 "${PLUGIN_DIR}/backend/ugreen-nas-ctl" "${PLUGIN_DIR}/backend/ugreen-nas-fan" \
    "${PLUGIN_DIR}/led/backend/ugreen-led-ctl" "${PLUGIN_DIR}/led/backend/ugreen-led-i2c" "${PLUGIN_DIR}/event/stopping"

# A favorite (the heart on the Settings page) is a label in the Menu line of the
# .page file, which the copy above has just replaced. Unraid puts it back at
# boot only, so do that now as well.
if [ -x /usr/local/emhttp/webGui/scripts/restore_favorites ]; then
    /usr/local/emhttp/webGui/scripts/restore_favorites
fi

#
# Fan control: the IT8613E (DXP6800 Pro) or the IT5571 EC (DXP4800 GT) is reached through /dev/port, no kernel module.
# This also runs at boot.
#

if "${PLUGIN_DIR}/backend/ugreen-nas-fan" probe >/dev/null 2>&1; then
    "${PLUGIN_DIR}/backend/ugreen-nas-ctl" start 2>&1 | sed 's/^/[UGREEN NAS Control] /'
else
    log "WARNING: No supported fan controller found; only system info and temperatures are available."
fi

#
# LEDs, only if they were switched on (and nothing else writes them): saved settings,
# status daemon, night mode. This also runs at boot.
#

if [ -f "${BOOT_DIR}/led.enabled" ]; then
    "${PLUGIN_DIR}/backend/ugreen-nas-ctl" led-boot 2>&1 | sed 's/^/[UGREEN NAS Control] /'
fi

#
# Drop cached files of older versions
#

for dir in "${BOOT_DIR}"/*/; do
    [ -d "${dir}" ] || continue
    case "$(basename "${dir}")" in
        "${VERSION}") ;;
        *) rm -rf "${dir}" ;;
    esac
done

log "Installation complete."

]]>
</INLINE>
</FILE>

<!-- ========================================================= -->
<!-- REMOVE -->
<!-- ========================================================= -->

<FILE Run="/bin/bash" Method="remove">
<INLINE>
NAME="&name;"
BOOT_DIR="&bootDIR;"
<![CDATA[

PLUGIN_DIR="/usr/local/emhttp/plugins/${NAME}"

log() {
    echo "[UGREEN NAS Control] $1"
}

# Stopping writes the BIOS fan values back.
if [ -x "${PLUGIN_DIR}/backend/ugreen-nas-ctl" ]; then
    "${PLUGIN_DIR}/backend/ugreen-nas-ctl" stop >/dev/null 2>&1
    "${PLUGIN_DIR}/backend/ugreen-nas-ctl" led-stop >/dev/null 2>&1
fi

rm -rf "${PLUGIN_DIR}"
rm -rf "${BOOT_DIR}"
rm -f /var/run/ugreen-nas-control.*
/usr/local/sbin/update_cron

log "Removed, the fans run at the BIOS values again."

]]>
</INLINE>
</FILE>

</PLUGIN>

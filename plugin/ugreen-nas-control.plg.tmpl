<!-- INSTALL -->
<!-- ========================================================= -->

<!-- Entities are not expanded inside CDATA, so the scripts get them as variables first. -->
<FILE Run="/bin/bash">
<INLINE>
NAME="&name;"
VERSION="&version;"
BOOT_DIR="&bootDIR;"
ARCHIVE="&srcDIR;/@ARCHIVE@"
OTHER_PLG="@OTHER_PLG@"
EXEC_FILES="@EXEC_FILES@"
DATA_FILES="@DATA_FILES@"
# Symbolic links, "path=target": the tool names are links to the one binary backend/ugreen-nas.
LINKS="@LINKS@"
<![CDATA[

PLUGIN_DIR="/usr/local/emhttp/plugins/${NAME}"
# Hidden, so the webGUI menu scan (plugins/*/*.page) never sees a half-copied tree.
STAGE_DIR="/usr/local/emhttp/plugins/.${NAME}.new"
OLD_DIR="/usr/local/emhttp/plugins/.${NAME}.old"

log() {
    echo "[UGREEN NAS Control] $1"
}

stop_daemons() {
    # The daemon hands the fans back to the BIOS values; the LED daemon and an LED effect must not keep writing either.
    if [ -x "${PLUGIN_DIR}/backend/ugreen-nas-ctl" ]; then
        "${PLUGIN_DIR}/backend/ugreen-nas-ctl" stop >/dev/null 2>&1
        "${PLUGIN_DIR}/backend/ugreen-nas-ctl" led-stop >/dev/null 2>&1
    fi
}

# Fan control: the IT8613E (DXP6800 Pro) or the IT5571 EC (DXP4800 GT) is reached through /dev/port, no kernel module.
# LEDs only if they were switched on. Both also run at boot. Neither is an install failure.
start_daemons() {
    if "${PLUGIN_DIR}/backend/ugreen-nas-fan" probe >/dev/null 2>&1; then
        "${PLUGIN_DIR}/backend/ugreen-nas-ctl" start 2>&1 | sed 's/^/[UGREEN NAS Control] /'
    else
        log "WARNING: No supported fan controller found; only system info and temperatures are available."
    fi
    if [ -f "${BOOT_DIR}/led.enabled" ]; then
        "${PLUGIN_DIR}/backend/ugreen-nas-ctl" led-boot 2>&1 | sed 's/^/[UGREEN NAS Control] /'
    fi
}

# A non-zero exit makes the plugin manager report the install as failed.
die() {
    echo "[UGREEN NAS Control] ERROR: $1" >&2
    rm -rf "${STAGE_DIR}"
    exit 1
}

log "Installing ${VERSION} on kernel $(uname -r)"

# Stable and beta share the install folder and the settings; only one may be installed.
if [ -e "/boot/config/plugins/${OTHER_PLG}" ]; then
    die "${OTHER_PLG} is installed. Remove it on the Plugins page first (your settings stay)."
fi

[ -f "${ARCHIVE}" ] || die "${ARCHIVE} is missing; the download did not finish."

#
# Stage: unpack and check everything next to the live folder. The running install is not touched yet.
# tar -m: the files get the time of the install, not the archive's fixed time (browsers cache by Last-Modified).
#

rm -rf "${STAGE_DIR}" "${OLD_DIR}"
mkdir -p "${STAGE_DIR}" || die "cannot create ${STAGE_DIR}"
command -v xz >/dev/null || die "xz is missing; the archive cannot be unpacked"
# Only files, folders and links, none outside the install folder.
tar -tvJf "${ARCHIVE}" | awk 'substr($1, 1, 1) !~ /[-dl]/ { bad = 1 } END { exit bad }' || die "${ARCHIVE} holds entries that are not files, folders or links"
tar -tJf "${ARCHIVE}" | grep -Eq '^/|(^|/)\.\.(/|$)' && die "${ARCHIVE} holds paths outside the install folder"
tar -xJmf "${ARCHIVE}" -C "${STAGE_DIR}" --no-same-owner --no-same-permissions || die "unpacking ${ARCHIVE} failed"
for f in ${EXEC_FILES} ${DATA_FILES}; do
    [ -f "${STAGE_DIR}/${f}" ] || die "${f} is missing from ${ARCHIVE}"
done
for l in ${LINKS}; do
    [ "$(readlink "${STAGE_DIR}/${l%%=*}")" = "${l#*=}" ] || die "link ${l%%=*} is missing from ${ARCHIVE}"
done
set -- ${EXEC_FILES} ${DATA_FILES}
[ "$(find "${STAGE_DIR}" -type f | wc -l)" -eq "$#" ] || die "${ARCHIVE} holds files that are not on the install list"
set -- ${LINKS}
[ "$(find "${STAGE_DIR}" -type l | wc -l)" -eq "$#" ] || die "${ARCHIVE} holds links that are not on the install list"
for f in ${EXEC_FILES}; do
    chmod 755 "${STAGE_DIR}/${f}" || die "chmod ${f} failed"
done
for f in ${DATA_FILES}; do
    chmod 644 "${STAGE_DIR}/${f}" || die "chmod ${f} failed"
done
for l in ${LINKS}; do
    [ -x "${STAGE_DIR}/${l%%=*}" ] || die "link ${l%%=*} does not lead to the binary"
done

#
# Swap: stop the old daemons, move the old tree away, move the new one in (same folder, so each mv is atomic).
#

stop_daemons

if [ -d "${PLUGIN_DIR}" ]; then
    mv "${PLUGIN_DIR}" "${OLD_DIR}" || { start_daemons; die "cannot move the old install away"; }
fi
if ! mv "${STAGE_DIR}" "${PLUGIN_DIR}"; then
    [ -d "${OLD_DIR}" ] && mv "${OLD_DIR}" "${PLUGIN_DIR}"
    start_daemons
    die "cannot move the new install in; the old one is back"
fi
rm -rf "${OLD_DIR}"

# A favorite (the heart on the Settings page) is a label in the Menu line of the
# .page file, which the swap has just replaced. Unraid puts it back at
# boot only, so do that now as well.
if [ -x /usr/local/emhttp/webGui/scripts/restore_favorites ]; then
    /usr/local/emhttp/webGui/scripts/restore_favorites
fi

start_daemons

#
# Drop cached files of older versions: only folders named like a version (3.6, 3.6.b000123).
# Settings (fan.cfg, leds.cfg, fan_rpm.json, led.enabled) and anything else in there stay.
#

for dir in "${BOOT_DIR}"/*/; do
    [ -d "${dir}" ] || continue
    base="$(basename "${dir}")"
    [ "${base}" = "${VERSION}" ] && continue
    if [[ "${base}" =~ ^[0-9]+\.[0-9]+(\.b[0-9]+)?$ ]]; then
        rm -rf "${dir}"
    fi
done

log "Installation complete."

]]>

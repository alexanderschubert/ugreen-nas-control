#!/usr/bin/env bash
# Fast checks on the staged files only; `just check` runs everything. Enabled by `just setup`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Outside `nix develop` the tools are missing: run again inside it.
if [ -z "${IN_NIX_SHELL:-}" ] && command -v nix >/dev/null; then
    exec nix develop -c "$0" "$@"
fi

staged() { git diff --cached --name-only --diff-filter=ACM -z -- "$@"; }
failed=0
fail() {
    echo "pre-commit: $1" >&2
    failed=1
}

# Bun formats TS, JS, CSS, HTML, JSON, YAML and Markdown (bunfig.toml); files outside its scope are skipped.
bun --config=web/bunfig.toml fmt --staged --check --ignore-unknown --no-error-on-unmatched-pattern --log-level=error || fail "formatting: run 'just fmt' and stage the result"

mapfile -d '' go_files < <(staged '*.go')
if [ "${#go_files[@]}" -gt 0 ]; then
    unformatted=$(gofmt -l "${go_files[@]}")
    [ -z "$unformatted" ] || fail "gofmt: $unformatted"
fi

mapfile -d '' sh_files < <(staged '*.sh' 'plugin/event/*' '.github/hooks/*')
if [ "${#sh_files[@]}" -gt 0 ]; then
    shfmt -d "${sh_files[@]}" >&2 || fail "shfmt: run 'just fmt'"
fi

mapfile -d '' php_files < <(staged '*.php')
if [ "${#php_files[@]}" -gt 0 ]; then
    for f in "${php_files[@]}"; do php -l "$f" >/dev/null || fail "php -l: $f"; done
    php-cs-fixer fix --config=web/.php-cs-fixer.dist.php --using-cache=no --dry-run --format=txt --quiet --path-mode=intersection -- "${php_files[@]}" || fail "php-cs-fixer: run 'just fmt'"
fi

mapfile -d '' xml_files < <(staged '*.xml' '*.svg')
if [ "${#xml_files[@]}" -gt 0 ]; then
    xmllint --noout "${xml_files[@]}" || fail "xmllint"
fi

exit "$failed"
